@model IEnumerable<SIGEBI.Application.DTOs.Response.CategoriaResponse>
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Catálogo</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-tags me-2"></i>Gestión de Categorías</h1>
            <p class="hero-description mb-0">Administración de las categorías para la clasificación de recursos.</p>
        </div>
        <div>
            <a asp-action="Crear" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Nueva Categoría
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>NOMBRE</th>
                    <th>DESCRIPCIÓN</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="ID" class="fw-bold text-body-secondary">@item.CategoriaId</td>
                            <td data-label="NOMBRE" class="fw-bold text-body-emphasis">@item.Nombre</td>
                            <td data-label="DESCRIPCIÓN" class="text-body-secondary">
                                @(string.IsNullOrWhiteSpace(item.Descripcion) ? "N/A" : item.Descripcion)
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center py-4 text-body-secondary">No se encontraron categorías registradas.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>