@model SIGEBI.AppWeb.Models.Categoria.CategoriaViewModel
@{
    ViewData["Title"] = "Crear Categoría";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Registrar Nueva Categoría</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-bold">Nombre de la Categoría</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej. Ficción, Tecnología..." required />
                            <span asp-validation-for="Nombre" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-bold">Descripción (Opcional)</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Breve detalle de esta categoría..."></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-primary">Guardar Categoría</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>