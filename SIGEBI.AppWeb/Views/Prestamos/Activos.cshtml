@model SIGEBI.AppWeb.Models.Prestamos.PrestamoFiltroViewModel

@{
    ViewData["Title"] = "Préstamos Activos";
    var esGestor = User.IsInRole("Administrador") || User.IsInRole("Bibliotecario");
    var esBibliotecario = User.IsInRole("Bibliotecario");
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div>
        <span class="hero-badge">Módulo de Préstamos</span>
        <h1 class="fw-bold mb-2"><i class="bi bi-journal-check me-2"></i>Préstamos Activos</h1>
        <p class="hero-description mb-0">Controla los ejemplares entregados actualmente y verifica fechas de devolución.</p>
    </div>
</div>

<!-- ALERTAS -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- FORMULARIO DE FILTROS -->
<div class="content-card card shadow-sm rounded-4 border-0 p-4 mb-4">
    <form method="get" asp-action="Activos" class="row g-3 align-items-end">
        @if (esGestor)
        {
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-body-secondary">Identificación de Usuario</label>
                <input type="text" name="identificacion" value="@Model.Identificacion" class="form-control" placeholder="Matrícula o Cédula..." />
            </div>
        }
        <div class="col-md-@(esGestor ? "3" : "5")">
            <label class="form-label fw-semibold small text-body-secondary">ID Recurso</label>
            <input type="number" name="recursoId" value="@Model.RecursoBibliograficoId" class="form-control" placeholder="Ej. 1" />
        </div>
        <div class="col-md-@(esGestor ? "3" : "5")">
            <label class="form-label fw-semibold small text-body-secondary">ID Ejemplar</label>
            <input type="number" name="ejemplarId" value="@Model.EjemplarId" class="form-control" placeholder="Ej. 2" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold shadow-sm" title="Filtrar">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Activos" class="btn btn-outline-secondary w-100 fw-semibold" title="Limpiar filtros">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- TABLA DE PRÉSTAMOS ACTIVOS -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>RECURSO</th>
                    <th>EJEMPLAR</th>
                    <th>FECHA INICIO</th>
                    <th>FECHA LÍMITE</th>
                    <th class="text-center">ESTADO</th>
                    @if (esBibliotecario)
                    {
                        <th class="text-end">ACCIONES</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Prestamos == null || !Model.Prestamos.Any())
                {
                    <tr>
                        <td colspan="@(esBibliotecario ? 6 : 5)" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-folder2-open display-6 d-block mb-2"></i>
                            No hay préstamos activos registrados con los filtros especificados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Prestamos)
                    {
                        <tr>
                            <td data-label="Recurso" class="fw-bold text-body-emphasis">@item.TituloRecurso</td>
                            <td data-label="Ejemplar" class="text-body-secondary">@item.IdentificadorEjemplar</td>
                            <td data-label="Fecha Inicio" class="text-body-secondary">@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td data-label="Fecha Límite" class="text-body-secondary">@item.FechaLimite.ToString("dd/MM/yyyy")</td>
                            <td data-label="Estado" class="text-center">
                                @if (item.EstaVencido)
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="bi bi-exclamation-circle-fill"></i> Vencido
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">
                                        <i class="bi bi-check-circle-fill"></i> @item.Estado
                                    </span>
                                }
                            </td>
                            @if (esBibliotecario)
                            {
                                <td data-label="Acciones" class="actions-cell text-end">
                                    <button type="button" class="btn btn-sm btn-success fw-semibold text-white px-3 shadow-sm"
                                            style="background-color: #14733c;"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalDevolucion"
                                            data-prestamo-id="@item.PrestamoId">
                                        <i class="bi bi-box-arrow-in-down me-1"></i> Devolver
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- MODAL DE REGISTRO DE DEVOLUCIÓN (INTEGRADO CON CONTENT-CARD) -->
<div class="modal fade" id="modalDevolucion" tabindex="-1" aria-labelledby="modalDevolucionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content content-card card rounded-4 border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-body-emphasis" id="modalDevolucionLabel">
                    <i class="bi bi-box-arrow-in-down text-success me-2"></i>Registrar Recepción de Ejemplar
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-controller="Devoluciones" asp-action="Registrar" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" id="PrestamoIdInput" name="PrestamoId" />

                <div class="modal-body py-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold text-body-secondary">Condición del Ejemplar <span class="text-danger">*</span></label>
                        <select name="Condicion" class="form-select rounded-3" required>
                            <option value="Bueno">Bueno (Sin daños aparentes)</option>
                            <option value="Dañado">Dañado (Requiere revisión o reparación)</option>
                            <option value="Extraviado">Extraviado (No devuelto / Perdido)</option>
                        </select>
                        <div class="form-text small text-muted mt-1">
                            Nota: Si selecciona "Dañado" o "Extraviado", el sistema retirará automáticamente el ejemplar del inventario activo.
                        </div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label fw-semibold text-body-secondary">Observaciones Adicionales</label>
                        <textarea name="Observacion" rows="3" class="form-control rounded-3" placeholder="Detalles sobre el estado físico u observaciones..."></textarea>
                    </div>
                </div>

                <div class="modal-footer border-top-0 pt-0 pb-4 px-4">
                    <button type="button" class="btn btn-outline-secondary fw-semibold px-4 py-2 rounded-3" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success fw-bold px-4 py-2 rounded-3 text-white shadow-sm" style="background-color: #14733c;">
                        <i class="bi bi-check-circle me-1"></i> Confirmar Devolución
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalDevolucion = document.getElementById('modalDevolucion');
        if (modalDevolucion) {
            modalDevolucion.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const prestamoId = button.getAttribute('data-prestamo-id');
                const inputPrestamoId = modalDevolucion.querySelector('#PrestamoIdInput');
                inputPrestamoId.value = prestamoId;
            });
        }
    </script>
}