@model SIGEBI.AppWeb.Models.Prestamos.PrestamoFiltroViewModel

@{
    ViewData["Title"] = "Historial de Préstamos";
    var esGestor = User.IsInRole("Administrador") || User.IsInRole("Bibliotecario");
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div>
        <span class="hero-badge">Módulo de Préstamos</span>
        <h1 class="fw-bold mb-2"><i class="bi bi-clock-history me-2"></i>Historial de Préstamos</h1>
        <p class="hero-description mb-0">Consulta el registro histórico de todos los préstamos y devoluciones realizadas.</p>
    </div>
</div>

<!-- FORMULARIO DE FILTROS -->
<div class="content-card card shadow-sm rounded-4 border-0 p-4 mb-4">
    <form method="get" asp-action="Historial" class="row g-3 align-items-end">
        @if (esGestor)
        {
            <div class="col-md-4">
                <label class="form-label fw-semibold small text-body-secondary">Identificación de Usuario</label>
                <input type="text" name="identificacion" value="@Model.Identificacion" class="form-control" placeholder="Matrícula o Cédula..." />
            </div>
        }
        <div class="col-md-@(esGestor ? "3" : "5")">
            <label class="form-label fw-semibold small text-body-secondary">ID Recurso</label>
            <input type="number" name="recursoId" value="@Model.RecursoBibliograficoId" class="form-control" placeholder="Ej. 1" />
        </div>
        <div class="col-md-@(esGestor ? "3" : "5")">
            <label class="form-label fw-semibold small text-body-secondary">ID Ejemplar</label>
            <input type="number" name="ejemplarId" value="@Model.EjemplarId" class="form-control" placeholder="Ej. 2" />
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100 fw-semibold shadow-sm" title="Filtrar">
                <i class="bi bi-search"></i>
            </button>
            <a asp-action="Historial" class="btn btn-outline-secondary w-100 fw-semibold" title="Limpiar filtros">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        </div>
    </form>
</div>

<!-- TABLA DE HISTORIAL -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>RECURSO</th>
                    <th>EJEMPLAR</th>
                    <th>FECHA INICIO</th>
                    <th>FECHA LÍMITE</th>
                    <th class="text-center">ESTADO</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Prestamos == null || !Model.Prestamos.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-folder2-open display-6 d-block mb-2"></i>
                            No se encontraron registros en el historial con los filtros especificados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Prestamos)
                    {
                        <tr>
                            <td data-label="Recurso" class="fw-bold text-body-emphasis">@item.TituloRecurso</td>
                            <td data-label="Ejemplar" class="text-body-secondary">@item.IdentificadorEjemplar</td>
                            <td data-label="Fecha Inicio" class="text-body-secondary">@item.FechaInicio.ToString("dd/MM/yyyy")</td>
                            <td data-label="Fecha Límite" class="text-body-secondary">@item.FechaLimite.ToString("dd/MM/yyyy")</td>
                            <td data-label="Estado" class="text-center">
                                <span class="status-badge status-active">
                                    <i class="bi bi-dot"></i> @item.Estado
                                </span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>