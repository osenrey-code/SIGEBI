@model SIGEBI.AppWeb.Models.Prestamos.PrestamoIndexViewModel

@{
    ViewData["Title"] = "Gestión de Préstamos";
    var esGestor = User.IsInRole("Administrador") || User.IsInRole("Bibliotecario");
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Préstamos</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-arrow-left-right me-2"></i>Gestión de Solicitudes y Préstamos</h1>
            <p class="hero-description mb-0">Visualiza las solicitudes pendientes, aprueba préstamos y controla las entregas activas.</p>
        </div>
        <div>
            <a asp-action="Solicitar" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Solicitar Préstamo
            </a>
        </div>
    </div>
</div>

<!-- ALERTAS DE NOTIFICACIÓN -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- TABLA DE DATOS RESPONSIVE -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>RECURSO</th>
                    <th>EJEMPLAR</th>
                    <th>FECHA INICIO</th>
                    <th>FECHA LÍMITE</th>
                    <th class="text-center">ESTADO</th>
                    @if (esGestor)
                    {
                        <th class="text-end">ACCIONES</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (Model.Prestamos == null || !Model.Prestamos.Any())
                {
                    <tr>
                        <td colspan="@(esGestor ? 6 : 5)" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-folder2-open display-6 d-block mb-2"></i>
                            No hay solicitudes ni préstamos registrados en este momento.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Prestamos)
                    {
                        <tr>
                            <td data-label="Recurso" class="fw-bold text-body-emphasis">@item.TituloRecurso</td>
                            <td data-label="Ejemplar" class="text-body-secondary">@item.IdentificadorEjemplar</td>
                            <td data-label="Fecha Inicio" class="text-body-secondary">
                                @(item.FechaInicio == default ? "Pendiente" : item.FechaInicio.ToString("dd/MM/yyyy"))
                            </td>
                            <td data-label="Fecha Límite" class="text-body-secondary">
                                @(item.FechaLimite == default ? "Pendiente" : item.FechaLimite.ToString("dd/MM/yyyy"))
                            </td>
                            <td data-label="Estado" class="text-center">
                                @if (item.EstaVencido)
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="bi bi-exclamation-circle-fill"></i> Vencido
                                    </span>
                                }
                                else if (item.Estado.Equals("Pendiente", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="status-badge" style="color: #664400; background: #fff0ba;">
                                        <i class="bi bi-clock-fill"></i> Pendiente
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-active">
                                        <i class="bi bi-check-circle-fill"></i> @item.Estado
                                    </span>
                                }
                            </td>
                            @if (esGestor)
                            {
                                <td data-label="Acciones" class="actions-cell text-end">
                                    @if (item.Estado.Equals("Pendiente", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <form asp-action="Aprobar" asp-route-id="@item.PrestamoId" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success fw-semibold" title="Aprobar Solicitud">
                                                <i class="bi bi-check-lg me-1"></i> Aprobar
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-body-secondary small">N/D</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>