@using System.Security.Claims
@model SIGEBI.AppWeb.Models.ViewModels.Penalizaciones.PenalizacionFiltroViewModel;

@{
    ViewData["Title"] = "Gestión de Penalizaciones";

    var esAdministrador = User.IsInRole("Administrador");
    var esBibliotecario = User.IsInRole("Bibliotecario");
    var esLector = User.IsInRole("Estudiante") || User.IsInRole("Docente");
    var puedeResolver = esAdministrador || esBibliotecario;
}

<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Sanciones</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-exclamation-octagon-fill me-2"></i>Gestión de Penalizaciones</h1>
            <p class="hero-description mb-0">Consulta de moras, penalizaciones activas y registro de resoluciones.</p>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Buscador y Filtros -->
<div class="content-card card shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            @if (!esLector)
            {
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-person-vcard text-body-secondary"></i></span>
                        <input type="text" name="usuarioId" class="form-control border-start-0" placeholder="Matrícula / Código / ID..." value="@Model.UsuarioId" />
                    </div>
                </div>
            }
            <div class="@(esLector ? "col-md-6" : "col-md-3")">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0"><i class="bi bi-journal-bookmark text-body-secondary"></i></span>
                    <input type="number" name="prestamoId" class="form-control border-start-0" placeholder="ID de Préstamo..." value="@Model.PrestamoId" />
                </div>
            </div>
            <div class="@(esLector ? "col-md-4" : "col-md-3")">
                <select name="estado" class="form-select">
                    <option value="">-- Todos los Estados --</option>
                    <option value="Activa" selected="@(Model.Estado == "Activa")">Activas</option>
                    <option value="Resuelta" selected="@(Model.Estado == "Resuelta")">Resueltas</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100 fw-semibold">
                    <i class="bi bi-search"></i>
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary w-100 fw-semibold" title="Limpiar Filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Penalizaciones -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4"># ID</th>
                    @if (!esLector)
                    {
                        <th>MATRÍCULA / CÓDIGO</th>
                    }
                    <th>PRÉSTAMO ID</th>
                    <th class="text-center">DÍAS RETRASO</th>
                    <th class="text-end">MONTO MORA</th>
                    <th>MOTIVO</th>
                    <th class="text-center">ESTADO</th>
                    <th>FECHA GENERACIÓN</th>
                    @if (puedeResolver)
                    {
                        <th class="text-end pe-4">ACCIONES</th>
                    }
                </tr>
            </thead>
            @* <tbody>
               // @if (Model.Penalizaciones != null && Model.Penalizaciones.Any())
                {
                    @foreach (var item in Model.Penalizaciones)
                    {
                        var esActiva = item.Estado.Equals("Activa", StringComparison.OrdinalIgnoreCase);
                        var identificacion = !string.IsNullOrWhiteSpace(item.IdentificacionUsuario)
                            ? item.IdentificacionUsuario
                            : $"ID: {item.UsuarioId}";

                        <tr>
                            <td class="ps-4 fw-bold font-monospace">#@item.PenalizacionId</td>

                            @if (!esLector)
                            {
                                <td class="fw-semibold font-monospace">@identificacion</td>
                            }

                            <td class="font-monospace">#@item.PrestamoId</td>

                            <td class="text-center">
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-1 fw-bold">
                                    @item.DiasRetraso días
                                </span>
                            </td>

                            <td class="text-end fw-bold text-body-emphasis">
                                RD$ @item.MontoMora.ToString("N2")
                            </td>

                            <td class="small text-body-secondary" style="max-width: 200px;">
                                @item.Motivo
                            </td>

                            <td class="text-center">
                                <span class="badge @(esActiva ? "bg-danger text-white" : "bg-success-subtle text-success border border-success-subtle") px-3 py-1.5 rounded-pill fw-semibold">
                                    <i class="bi @(esActiva ? "bi-exclamation-circle-fill" : "bi-check-circle-fill") me-1"></i>
                                    @item.Estado
                                </span>
                            </td>

                            <td class="small text-body-secondary">
                                @item.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")
                            </td>

                            @if (puedeResolver)
                            {
                                <td class="text-end pe-4">
                                    @if (esActiva)
                                    {
                                        <button type="button"
