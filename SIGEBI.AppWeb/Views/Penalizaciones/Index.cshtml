                                                onclick="prepararResolucion(@item.PenalizacionId, '@identificacion', '@item.MontoMora.ToString("N2")')"
                                                title="Resolver Penalización">
                                            <i class="bi bi-check2-circle"></i> Resolver
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-1 opacity-50" disabled title="Ya resuelta">
                                            <i class="bi bi-check-all"></i> Resuelta
                                        </button>
                                    }
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@(puedeResolver ? 9 : (esLector ? 7 : 8))" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-shield-check fs-1 d-block mb-2 text-body-tertiary"></i>
                            <span>No se encontraron penalizaciones registradas.</span>
                        </td>
                    </tr>
                }
            </tbody> *@
        </table>
    </div>
</div>

<!-- Modal Adaptable (Tema Claro / Tema Oscuro) -->
@if (puedeResolver)
{
    <div class="modal fade" id="modalResolverPenalizacion" tabindex="-1" aria-labelledby="modalResolverLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-success text-white border-0 py-3">
                    <h5 class="modal-title fw-bold" id="modalResolverLabel">
                        <i class="bi bi-check-circle-fill me-2"></i>Resolver Penalización
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Resolver" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <input type="hidden" id="resolverPenalizacionId" name="penalizacionId" />

                        <!-- Caja de Información Adaptable a Tema Claro / Oscuro -->
                        <div class="p-3 bg-secondary bg-opacity-10 border border-secondary border-opacity-25 rounded-3 mb-4">
                            <div class="d-flex align-items-center justify-content-between">
                                <div>
                                    <span class="d-block small text-body-secondary">Penalización:</span>
                                    <strong id="resolverPenalizacionInfo" class="fs-6 text-body-emphasis"></strong>
                                </div>
                                <div class="text-end">
                                    <span class="d-block small text-body-secondary">Monto Mora:</span>
                                    <span id="resolverMontoInfo" class="fw-bold text-danger fs-5"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="motivoResolucion" class="form-label fw-bold text-body-emphasis">Motivo de Resolución (Obligatorio)</label>
                            <textarea id="motivoResolucion" name="motivo" class="form-control" rows="3"
                                      placeholder="Ej. Pago realizado en caja, cumplimiento de condición o exoneración autorizada." required></textarea>
                            <span class="form-text text-body-secondary small">Indica la razón por la cual se habilita nuevamente al usuario para realizar préstamos.</span>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary border-opacity-10 px-4 py-3">
                        <button type="button" class="btn btn-outline-secondary fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success fw-semibold px-4">
                            <i class="bi bi-check-lg me-1"></i> Confirmar Resolución
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (puedeResolver)
    {
        <script>
            function prepararResolucion(penalizacionId, identificacion, monto) {
                document.getElementById('resolverPenalizacionId').value = penalizacionId;
                document.getElementById('resolverPenalizacionInfo').innerText = '#' + penalizacionId + ' (' + identificacion + ')';
                document.getElementById('resolverMontoInfo').innerText = 'RD$ ' + monto;
                document.getElementById('motivoResolucion').value = '';

                var modal = new bootstrap.Modal(document.getElementById('modalResolverPenalizacion'));
                modal.show();
            }
        </script>
    }
}