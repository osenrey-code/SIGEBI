@{
    ViewData["Title"] = "Reportes y Estadísticas";
}

<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Reportes</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-file-earmark-pdf-fill me-2"></i>Generación de Reportes PDF</h1>
            <p class="hero-description mb-0">Exporta información detallada del inventario, préstamos y penalizaciones del sistema.</p>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-4">
    <!-- REPORTE DE INVENTARIO -->
    <div class="col-md-4">
        <div class="content-card card shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-boxes me-2"></i>Inventario General</h5>
                    <p class="text-body-secondary small">Obtén un reporte detallado del estado actual de todos los ejemplares y recursos físicos registrados.</p>
                </div>
                <div class="mt-4">
                    <a asp-action="DescargarInventarioPdf" class="btn btn-primary w-100 fw-semibold py-2 rounded-3 shadow-sm">
                        <i class="bi bi-download me-1"></i> Descargar PDF
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- REPORTE DE PRÉSTAMOS -->
    <div class="col-md-4">
        <div class="content-card card shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-journal-check me-2"></i>Préstamos por Rango</h5>
                    <p class="text-body-secondary small">Analiza el volumen de préstamos, devoluciones puntuales y tasa de puntualidad en un periodo específico.</p>
                </div>
                <form asp-action="DescargarPrestamosPdf" method="post" class="mt-3">
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Fecha Inicio</label>
                        <input type="date" name="fechaInicio" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Fecha Fin</label>
                        <input type="date" name="fechaFin" class="form-control form-control-sm" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-semibold py-2 rounded-3 shadow-sm">
                        <i class="bi bi-download me-1"></i> Descargar PDF
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- REPORTE DE PENALIZACIONES -->
    <div class="col-md-4">
        <div class="content-card card shadow-sm rounded-4 h-100">
            <div class="card-body p-4 d-flex flex-column justify-content-between">
                <div>
                    <h5 class="fw-bold text-primary mb-3"><i class="bi bi-exclamation-octagon me-2"></i>Penalizaciones</h5>
                    <p class="text-body-secondary small">Visualiza el resumen de multas generadas, activas y montos acumulados por tipo de usuario.</p>
                </div>
                <form asp-action="DescargarPenalizacionesPdf" method="post" class="mt-3">
                    <div class="mb-2">
                        <label class="form-label small fw-bold">Fecha Inicio</label>
                        <input type="date" name="fechaInicio" class="form-control form-control-sm" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Fecha Fin</label>
                        <input type="date" name="fechaFin" class="form-control form-control-sm" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 fw-semibold py-2 rounded-3 shadow-sm">
                        <i class="bi bi-download me-1"></i> Descargar PDF
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>