@model SIGEBI.Application.DTOs.Response.ReporteResponse.ReporteInventarioResponse

@{
    ViewData["Title"] = "Reporte de Inventario";
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Reportes</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-boxes me-2"></i>Reporte de Inventario</h1>
            <p class="hero-description mb-0">Estado general y distribución de recursos bibliográficos en el sistema.</p>
        </div>
        <div>
            <a asp-action="InventarioPdf" class="btn btn-danger fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-pdf-fill"></i> Exportar PDF
            </a>
            <a asp-action="Index" class="btn btn-light fw-semibold px-3 py-2 rounded-3 shadow-sm ms-2">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>

<!-- TARJETAS DE RESUMEN (KPIs) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">TOTAL RECURSOS</div>
            <h3 class="fw-bold text-body-emphasis mb-0">@Model.TotalRecursos</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">TOTAL EJEMPLARES</div>
            <h3 class="fw-bold text-body-emphasis mb-0">@Model.TotalEjemplares</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">DISPONIBLES</div>
            <h3 class="fw-bold text-success mb-0">@Model.EjemplaresDisponibles</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">PRESTADOS</div>
            <h3 class="fw-bold text-primary mb-0">@Model.EjemplaresPrestados</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">RESERVADOS</div>
            <h3 class="fw-bold text-warning mb-0">@Model.EjemplaresReservados</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">FUERA DE SERVICIO</div>
            <h3 class="fw-bold text-danger mb-0">@Model.EjemplaresFueraDeServicio</h3>
        </div>
    </div>
</div>

<!-- TABLA DE DETALLE -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="p-4 border-bottom">
        <h5 class="fw-bold mb-0 text-body-emphasis">Detalle por Recurso Bibliográfico</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>ISBN</th>
                    <th>TÍTULO</th>
                    <th>CATEGORÍA</th>
                    <th class="text-center">TOTAL</th>
                    <th class="text-center">DISP.</th>
                    <th class="text-center">PREST.</th>
                    <th class="text-center">RES.</th>
                    <th class="text-center">FUERA SERV.</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Recursos == null || !Model.Recursos.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-folder2-open display-6 d-block mb-2"></i>
                            No hay registros de inventario disponibles.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model.Recursos)
                    {
                        <tr>
                            <td data-label="ISBN" class="text-body-secondary font-monospace">@item.ISBN</td>
                            <td data-label="Título" class="fw-bold text-body-emphasis">@item.Titulo</td>
                            <td data-label="Categoría">
                                <span class="badge" style="background-color: #fff0ba; color: #664400; font-weight: 600;">@item.Categoria</span>
                            </td>
                            <td data-label="Total" class="text-center fw-semibold">@item.TotalEjemplares</td>
                            <td data-label="Disponibles" class="text-center text-success fw-bold">@item.Disponibles</td>
                            <td data-label="Prestados" class="text-center text-primary">@item.Prestados</td>
                            <td data-label="Reservados" class="text-center text-warning">@item.Reservados</td>
                            <td data-label="Fuera de Servicio" class="text-center text-danger">@item.FueraDeServicio</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>