@model SIGEBI.AppWeb.Models.Reportes.ReportePenalizacionesViewModel

@{
    ViewData["Title"] = "Reporte de Penalizaciones";
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Reportes</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-exclamation-triangle me-2"></i>Reporte de Penalizaciones</h1>
            <p class="hero-description mb-0">Control de moras, días de retraso y sanciones emitidas por tipo de usuario.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="PenalizacionesPdf" asp-route-fechaInicio="@Model.FechaInicio.ToString("yyyy-MM-dd")" asp-route-fechaFin="@Model.FechaFin.ToString("yyyy-MM-dd")" class="btn btn-danger fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-file-earmark-pdf-fill"></i> Exportar PDF
            </a>
            <a asp-action="Index" class="btn btn-light fw-semibold px-3 py-2 rounded-3 shadow-sm">
                <i class="bi bi-arrow-left"></i> Volver
            </a>
        </div>
    </div>
</div>

<!-- FILTRO POR FECHAS -->
<div class="content-card card shadow-sm rounded-4 border-0 p-4 mb-4">
    <form method="get" asp-action="Penalizaciones" class="row g-3 align-items-end">
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-body-secondary">Fecha Inicio</label>
            <input type="date" name="fechaInicio" value="@Model.FechaInicio.ToString("yyyy-MM-dd")" class="form-control rounded-3" />
        </div>
        <div class="col-md-4">
            <label class="form-label fw-semibold small text-body-secondary">Fecha Fin</label>
            <input type="date" name="fechaFin" value="@Model.FechaFin.ToString("yyyy-MM-dd")" class="form-control rounded-3" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary fw-bold w-100 rounded-3 shadow-sm">
                <i class="bi bi-filter me-2"></i> Filtrar Reporte
            </button>
        </div>
    </form>
</div>

<!-- TARJETAS DE RESUMEN (KPIs) -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">TOTAL PENALIZACIONES</div>
            <h3 class="fw-bold text-body-emphasis mb-0">@Model.Reporte.TotalPenalizaciones</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">PENALIZACIONES ACTIVAS</div>
            <h3 class="fw-bold text-danger mb-0">@Model.Reporte.PenalizacionesActivas</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">RESUELTAS</div>
            <h3 class="fw-bold text-success mb-0">@Model.Reporte.PenalizacionesResueltas</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">TOTAL DÍAS RETRASO</div>
            <h3 class="fw-bold text-warning mb-0">@Model.Reporte.TotalDiasRetraso días</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">MONTO TOTAL MORA</div>
            <h3 class="fw-bold text-primary mb-0">$@Model.Reporte.MontoTotalMora.ToString("N2")</h3>
        </div>
    </div>
    <div class="col-sm-6 col-xl-4">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4">
            <div class="text-muted small fw-semibold mb-1">MORA ACTIVA VIGENTE</div>
            <h3 class="fw-bold text-danger mb-0">$@Model.Reporte.MontoMoraActiva.ToString("N2")</h3>
        </div>
    </div>
</div>

<!-- DESGLOSE POR TIPO DE USUARIO -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="p-4 border-bottom">
        <h5 class="fw-bold mb-0 text-body-emphasis">Desglose por Tipo de Usuario</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>TIPO USUARIO</th>
                    <th class="text-center">GENERADAS</th>
                    <th class="text-center">ACTIVAS</th>
                    <th class="text-center">RESUELTAS</th>
                    <th class="text-end">MONTO TOTAL</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Reporte.PorTipoUsuario == null || !Model.Reporte.PorTipoUsuario.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-4 text-body-secondary">No hay datos por tipo de usuario.</td>
                    </tr>
                }
                else
                {
                    @foreach (var tipo in Model.Reporte.PorTipoUsuario)
                    {
                        <tr>
                            <td class="fw-bold text-body-emphasis">@tipo.TipoUsuario</td>
                            <td class="text-center">@tipo.Generadas</td>
                            <td class="text-center text-danger fw-semibold">@tipo.Activas</td>
                            <td class="text-center text-success">@tipo.Resueltas</td>
                            <td class="text-end fw-bold">$@tipo.MontoTotal.ToString("N2")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<!-- DETALLE DE PENALIZACIONES -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="p-4 border-bottom">
        <h5 class="fw-bold mb-0 text-body-emphasis">Detalle de Sanciones</h5>
    </div>
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>MOTIVO</th>
                    <th>TIPO USUARIO</th>
                    <th class="text-center">DÍAS RETRASO</th>
                    <th class="text-end">MORA</th>
                    <th>FECHA</th>
                    <th class="text-center">ESTADO</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Reporte.Detalles == null || !Model.Reporte.Detalles.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-body-secondary">No hay penalizaciones registradas en este período.</td>
                    </tr>
                }
                else
                {
                    @foreach (var det in Model.Reporte.Detalles)
                    {
                        <tr>
                            <td class="fw-bold text-body-emphasis">@det.Motivo</td>
                            <td><span class="badge bg-secondary">@det.TipoUsuario</span></td>
                            <td class="text-center">@det.DiasRetraso</td>
                            <td class="text-end fw-semibold text-danger">$@det.MontoMora.ToString("N2")</td>
                            <td class="text-body-secondary">@det.FechaGeneracion.ToString("dd/MM/yyyy")</td>
                            <td class="text-center">
                                <span class="badge" style="background-color: #f8cecc; color: #c00000; font-weight: 600;">@det.Estado</span>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>