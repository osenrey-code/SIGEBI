@model SIGEBI.AppWeb.Models.DTOs.Notificaciones.NotificacionResponse

@{
    ViewData["Title"] = "Detalle de Notificación";
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <span class="hero-badge">Centro de Novedades</span>
            <h1 class="fw-bold mb-1"><i class="bi bi-envelope-open-fill me-2"></i>Detalle de Notificación</h1>
        </div>
        <a asp-action="Index" class="btn btn-outline-light text-white fw-bold px-3 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
            <i class="bi bi-arrow-left"></i> Volver al listado
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="content-card card shadow-lg border-0 rounded-4 p-4 p-md-5">

            <div class="d-flex align-items-center justify-content-between mb-4 pb-3 border-bottom border-secondary border-opacity-10">
                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary-subtle px-3 py-2 rounded-pill fw-bold fs-6">
                    <i class="bi bi-tag-fill me-1"></i> @Model.Tipo
                </span>
                <span class="text-body-secondary small font-monospace">
                    <i class="bi bi-calendar3 me-1"></i>@(Model.FechaRegistro != default ? Model.FechaRegistro.ToString("dd/MM/yyyy - hh:mm tt") : DateTime.Now.ToString("dd/MM/yyyy - hh:mm tt"))
                </span>
            </div>

            <!-- CONTENIDO DE LA NOTIFICACIÓN -->
            <div class="my-3">
                <h5 class="text-body-secondary small text-uppercase fw-bold mb-2">Mensaje:</h5>
                <div class="p-4 rounded-4 bg-body-tertiary border">
                    <p class="fs-5 text-body-emphasis fw-medium mb-0" style="line-height: 1.6;">
                        @Model.Mensaje
                    </p>
                </div>
            </div>

            <!-- ACCIONES -->
            <div class="d-flex flex-column flex-sm-row gap-3 mt-4 pt-3 border-top border-secondary border-opacity-10">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-semibold rounded-3 flex-fill text-center">
                    <i class="bi bi-list-task me-1"></i> Ver todas
                </a>

                <!-- Formulario para Eliminar Notificación -->
                <form asp-controller="Notificacion" asp-action="Eliminar" asp-route-id="@Model.NotificacionId" method="post" class="flex-fill" onsubmit="return confirm('¿Deseas eliminar esta notificación?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-outline-danger btn-lg fw-semibold rounded-3 w-100">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </button>
                </form>

                <a asp-controller="Prestamos" asp-action="Index" class="btn btn-primary btn-lg fw-bold rounded-3 flex-fill shadow-sm d-inline-flex align-items-center justify-content-center gap-2">
                    <span>Ir a Mis Préstamos</span> <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </div>
    </div>
</div>