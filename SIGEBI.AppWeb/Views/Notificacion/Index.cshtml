@model IEnumerable<SIGEBI.AppWeb.Models.DTOs.Notificaciones.NotificacionResponse>

@{
    ViewData["Title"] = "Notificaciones";
    bool soloNoLeidas = ViewBag.SoloNoLeidas ?? false;
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Centro de Novedades</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-bell-fill me-2"></i>Mis Notificaciones</h1>
            <p class="hero-description mb-0">Revisa todas tus alertas, confirmaciones y avisos del sistema.</p>
        </div>
    </div>
</div>

<!-- ALERTAS DE SISTEMA -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 bg-danger-subtle text-danger alert-dismissible fade show rounded-4 p-3 mb-4 d-flex align-items-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <span>@TempData["Error"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
    </div>
}

<!-- FILTROS -->
<div class="content-card card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-3 d-flex align-items-center gap-2">
        <a asp-action="Index" asp-route-soloNoLeidas="false"
           class="btn btn-sm rounded-3 fw-semibold px-3 @(!soloNoLeidas ? "btn-primary" : "btn-outline-secondary")">
            <i class="bi bi-card-list me-1"></i> Todas
        </a>
        <a asp-action="Index" asp-route-soloNoLeidas="true"
           class="btn btn-sm rounded-3 fw-semibold px-3 @(soloNoLeidas ? "btn-primary" : "btn-outline-secondary")">
            <i class="bi bi-envelope-exclamation me-1"></i> Solo no leídas
        </a>
    </div>
</div>

<!-- LISTA DE NOTIFICACIONES -->
@if (Model != null && Model.Any())
{
    <div class="d-flex flex-column gap-3">
        @foreach (var item in Model)
        {
            <a asp-controller="Notificacion" asp-action="Detalles" asp-route-id="@item.NotificacionId"
               class="text-decoration-none">
                <div class="content-card card border-0 shadow-sm rounded-4 p-3 p-md-4 transition-all @(!item.Leida ? "border-start border-primary border-4" : "opacity-75")">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="d-flex align-items-start gap-3">
                            <div class="@(!item.Leida ? "bg-primary bg-opacity-10 text-primary" : "bg-body-tertiary text-body-secondary") p-3 rounded-circle d-none d-sm-flex align-items-center justify-content-center">
                                <i class="bi @(!item.Leida ? "bi-bell-fill" : "bi-bell") fs-4"></i>
                            </div>
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge @(!item.Leida ? "bg-primary bg-opacity-20 text-primary" : "bg-secondary bg-opacity-10 text-body-secondary") fw-bold px-2 py-1 rounded-pill small">
                                        @item.Tipo
                                    </span>
                                    @if (!item.Leida)
                                    {
                                        <span class="badge bg-danger rounded-pill extra-small">Nueva</span>
                                    }
                                </div>
                                <p class="text-body-emphasis fw-semibold mb-1 fs-6">@item.Mensaje</p>
                                <span class="text-body-secondary extra-small font-monospace">
                                    <i class="bi bi-clock me-1"></i>@item.FechaRegistro.ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </div>
                        </div>

                        <i class="bi bi-chevron-right text-body-tertiary fs-5 mt-2"></i>
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    <div class="content-card card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <i class="bi bi-bell-slash fs-1 d-block mb-3 text-body-tertiary"></i>
        <h4 class="fw-bold text-body-emphasis">No se encontraron notificaciones</h4>
        <p class="text-body-secondary mb-0">
            @(soloNoLeidas ? "No tienes notificaciones pendientes por leer." : "Cuando se generen alertas sobre tus solicitudes, aparecerán aquí.")
        </p>
    </div>
}

<style>
    .transition-all {
        transition: transform 0.2s ease, box-shadow 0.2s ease, opacity 0.2s ease;
    }

        .transition-all:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0,0,0,0.12) !important;
            opacity: 1 !important;
        }

    .extra-small {
        font-size: 0.75rem;
    }
</style>