@model IEnumerable<SIGEBI.Application.DTOs.Response.LogAuditoriaResponse>
@{
    ViewData["Title"] = "Logs de Auditoría";
    var filtros = ViewBag.Filtros as SIGEBI.Application.DTOs.Request.ConsultarLogAuditoriaRequest;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold m-0"><i class="bi bi-shield-check me-2"></i>Logs de Auditoría</h2>
        <p class="text-body-secondary small m-0">Registro y monitoreo de acciones realizadas en el sistema</p>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Formulario de Filtros -->
<div class="card border-0 shadow-sm rounded-3 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-controller="Auditoria" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold">ID Usuario</label>
                <input type="number" name="UsuarioId" value="@filtros?.UsuarioId" class="form-control form-control-sm" placeholder="Ej: 1" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Acción</label>
                <input type="text" name="Accion" value="@filtros?.Accion" class="form-control form-control-sm" placeholder="Ej: Registro" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Entidad Afectada</label>
                <input type="text" name="EntidadAfectada" value="@filtros?.EntidadAfectada" class="form-control form-control-sm" placeholder="Ej: Recurso" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Fecha Inicio</label>
                <input type="date" name="FechaInicio" value="@(filtros?.FechaInicio?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold">Fecha Fin</label>
                <input type="date" name="FechaFin" value="@(filtros?.FechaFin?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
                <a asp-controller="Auditoria" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Registros -->
<div class="card border-0 shadow-sm rounded-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="px-3"># ID</th>
                        <th>Usuario ID</th>
                        <th>Acción</th>
                        <th>Entidad</th>
                        <th>Detalle</th>
                        <th>Fecha y Hora</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="px-3 fw-semibold text-body-secondary">#@item.AuditoriaId</td>
                                <td><span class="badge bg-secondary rounded-pill">ID: @item.UsuarioId</span></td>
                                <td><span class="fw-semibold">@item.Accion</span></td>
                                <td><span class="badge bg-info-subtle text-info-emphasis px-2 py-1">@item.EntidadAfectada</span></td>
                                <td class="small text-wrap" style="max-width: 300px;">@item.Detalle</td>
                                <td class="small text-body-secondary">@item.FechaRegistro.ToString("g")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-4 text-body-secondary">
                                <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                No se encontraron registros de auditoría.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>