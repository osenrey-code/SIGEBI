@model IEnumerable<SIGEBI.Application.DTOs.Response.LogAuditoriaResponse>
@{
    ViewData["Title"] = "Logs de Auditoría";
    var filtros = ViewBag.Filtros as SIGEBI.Application.DTOs.Request.ConsultarLogAuditoriaRequest;
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Trazabilidad</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-shield-check me-2"></i>Logs de Auditoría</h1>
            <p class="hero-description mb-0">Registro y monitoreo inmutable de acciones realizadas en el sistema.</p>
        </div>
        <div>
            <a asp-controller="Reportes" asp-action="Index" class="btn btn-outline-light text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Volver a Reportes
            </a>
        </div>
    </div>
</div>

@if (ViewBag.Error != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@ViewBag.Error
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Formulario de Filtros -->
<div class="content-card card shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-controller="Auditoria" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-body-secondary">ID Usuario</label>
                <input type="number" name="UsuarioId" value="@filtros?.UsuarioId" class="form-control form-control-sm" placeholder="Ej: 1" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-body-secondary">Acción</label>
                <input type="text" name="Accion" value="@filtros?.Accion" class="form-control form-control-sm" placeholder="Ej: Registro" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-body-secondary">Entidad Afectada</label>
                <input type="text" name="EntidadAfectada" value="@filtros?.EntidadAfectada" class="form-control form-control-sm" placeholder="Ej: Recurso" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-body-secondary">Fecha Inicio</label>
                <input type="date" name="FechaInicio" value="@(filtros?.FechaInicio?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2">
                <label class="form-label small fw-semibold text-body-secondary">Fecha Fin</label>
                <input type="date" name="FechaFin" value="@(filtros?.FechaFin?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-sm w-100 fw-semibold">
                    <i class="bi bi-search me-1"></i>Filtrar
                </button>
                <a asp-controller="Auditoria" asp-action="Index" class="btn btn-outline-secondary btn-sm" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Registros -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4"># ID</th>
                    <th>Usuario ID</th>
                    <th>Acción</th>
                    <th>Entidad</th>
                    <th>Detalle</th>
                    <th class="pe-4">Fecha y Hora</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-semibold text-body-secondary">#@item.AuditoriaId</td>
                            <td>
                                <span class="badge bg-secondary bg-opacity-10 text-body border px-2.5 py-1 font-monospace">
                                    ID: @item.UsuarioId
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                    @item.Accion
                                </span>
                            </td>
                            <td>
                                <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-2.5 py-1.5 rounded-pill fw-semibold">
                                    @item.EntidadAfectada
                                </span>
                            </td>
                            <td class="small text-wrap text-body-secondary" style="max-width: 300px;">@item.Detalle</td>
                            <td class="small text-body-secondary pe-4 font-monospace">@item.FechaRegistro.ToString("g")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-shield-check fs-1 d-block mb-2 text-body-tertiary"></i>
                            <span>No se encontraron registros de auditoría.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>