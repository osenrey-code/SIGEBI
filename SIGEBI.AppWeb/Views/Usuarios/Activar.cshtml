@model SIGEBI.AppWeb.Models.Usuarios.ActivarUsuarioViewModel

@{
    ViewData["Title"] = "Activar Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-success text-white p-4 rounded-top-3">
                    <h4 class="mb-0 fw-bold">
                        <i class="bi bi-person-check-fill me-2"></i>Activar Usuario
                    </h4>

                    <small class="activate-header-subtitle">
                        Confirme la restauración de acceso al sistema
                    </small>
                </div>

                <div class="card-body p-4">
                    <p class="lead">¿Desea reactivar el acceso para el siguiente usuario?</p>

                    <div class="activate-user-info rounded-3 mb-4">
                        <div class="mb-2">
                            <span class="activate-user-label">IDENTIFICACIÓN:</span>
                            <span class="activate-user-value ms-2">@Model.Identificacion</span>
                        </div>

                        <div>
                            <span class="activate-user-label">NOMBRE COMPLETO:</span>
                            <span class="activate-user-value ms-2">@Model.NombreCompleto</span>
                        </div>
                    </div>

                    <form asp-action="Activar" method="post">
                        <input type="hidden" asp-for="UsuarioId" />

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-medium">
                                Cancelar
                            </a>

                            <button type="submit" class="btn btn-success btn-lg fw-bold px-4">
                                Confirmar Activar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>