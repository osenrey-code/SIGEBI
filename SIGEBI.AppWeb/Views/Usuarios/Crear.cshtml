@model SIGEBI.AppWeb.Models.Usuarios.RegistrarUsuarioViewModel

@{
    ViewData["Title"] = "Registrar Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary text-white p-4 rounded-top-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-person-plus-fill me-2"></i>Nuevo Usuario</h4>
                    <small class="text-white-50">Complete los campos obligatorios para registrar en el sistema</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Identificacion" class="form-label fw-bold"></label>
                            <input asp-for="Identificacion" class="form-control form-control-lg" placeholder="Ej. 20230001" autofocus />
                            <span asp-validation-for="Identificacion" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label fw-bold"></label>
                            <input asp-for="NombreCompleto" class="form-control form-control-lg" placeholder="Ej. Juan Pérez" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Correo" class="form-label fw-bold"></label>
                            <input asp-for="Correo" type="email" class="form-control form-control-lg" placeholder="ejemplo@institucion.edu" />
                            <span asp-validation-for="Correo" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Tipo" class="form-label fw-bold"></label>
                            <select asp-for="Tipo" class="form-select form-select-lg">
                                <option value="">-- Seleccione un Rol --</option>
                                <option value="Estudiante">Estudiante</option>
                                <option value="Profesor">Docente</option>
                                <option value="Bibliotecario">Bibliotecario</option>
                                <option value="Administrador">Administrador</option>
                                <option value="Auditor">Auditor</option>
                            </select>
                            <span asp-validation-for="Tipo" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-medium">Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">
                                <i class="bi bi-check-lg me-1"></i>Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>