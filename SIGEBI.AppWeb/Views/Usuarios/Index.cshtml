@model SIGEBI.AppWeb.Models.Usuarios.UsuarioIndexViewModel

@{
    ViewData["Title"] = "Gestión de usuarios";

    var totalUsuarios = Model?.Usuarios?.Count() ?? 0;
    var usuariosActivos = Model?.Usuarios?.Count(u =>
        string.Equals(u.Estado, "Activo", StringComparison.OrdinalIgnoreCase)) ?? 0;

    var usuariosInactivos = totalUsuarios - usuariosActivos;
}

<div class="d-flex flex-column gap-4">

    <section class="page-hero p-4 p-lg-5">
        <div class="position-relative z-1">
            <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-4">
                <div>
                    <span class="hero-badge">
                        <i class="bi bi-shield-check me-1"></i> Administración
                    </span>

                    <h1 class="display-6 fw-bold mb-2">Gestión de usuarios</h1>

                    <p class="mb-0 hero-description">
                        Consulta, administra y controla los accesos de las personas registradas.
                    </p>
                </div>

                @if (User.IsInRole("Administrador"))
                {
                    <a asp-action="Crear" class="btn btn-light text-primary fw-bold px-4 py-3 rounded-3 shadow-sm">
                        <i class="bi bi-person-plus-fill me-2"></i>Nuevo usuario
                    </a>
                }
            </div>
        </div>
    </section>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-0" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-0" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <section class="row g-3">
        <div class="col-md-4">
            <div class="metric-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="metric-icon metric-primary">
                    <i class="bi bi-people-fill"></i>
                </span>

                <div>
                    <div class="fs-4 fw-bold">@totalUsuarios</div>
                    <div class="small text-body-secondary">Usuarios mostrados</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="metric-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="metric-icon metric-success">
                    <i class="bi bi-person-check-fill"></i>
                </span>

                <div>
                    <div class="fs-4 fw-bold">@usuariosActivos</div>
                    <div class="small text-body-secondary">Usuarios activos</div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="metric-card p-3 h-100 d-flex align-items-center gap-3">
                <span class="metric-icon metric-danger">
                    <i class="bi bi-person-x-fill"></i>
                </span>

                <div>
                    <div class="fs-4 fw-bold">@usuariosInactivos</div>
                    <div class="small text-body-secondary">Usuarios inactivos</div>
                </div>
            </div>
        </div>
    </section>

    <section class="content-card p-3 p-lg-4">
        <form method="get" asp-action="Index" role="search">
            <label for="identificacionBusqueda" class="form-label fw-semibold">
                Buscar usuario
            </label>

            <div class="row g-2">
                <div class="col-lg">
                    <div class="input-group">
                        <span class="input-group-text border-end-0">
                            <i class="bi bi-search text-body-secondary"></i>
                        </span>

                        <input id="identificacionBusqueda"
                               type="search"
                               name="identificacionBusqueda"
                               value="@Model?.Identificacion"
                               class="form-control border-start-0"
                               placeholder="Ingrese una identificación..."
                               autocomplete="off" />
                    </div>
                </div>

                <div class="col-sm-auto d-grid">
                    <button type="submit" class="btn btn-primary px-4 fw-semibold">
                        Buscar
                    </button>
                </div>

                <div class="col-sm-auto d-grid">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Limpiar
                    </a>
                </div>
            </div>
        </form>
    </section>

    <section class="content-card overflow-hidden">
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-bottom content-card-header">
            <div>
                <h2 class="h5 fw-bold mb-1">Directorio de usuarios</h2>
                <p class="small text-body-secondary mb-0">
                    Administra los datos y el estado de cada cuenta.
                </p>
            </div>

            <span class="results-badge">
                @totalUsuarios resultado@(totalUsuarios == 1 ? "" : "s")
            </span>
        </div>

        <div class="table-responsive">
            <table class="table users-table table-hover align-middle mb-0">
                <caption class="visually-hidden">Listado de usuarios registrados</caption>

                <thead>
                    <tr>
                        <th class="ps-4 py-3">Usuario</th>
                        <th class="py-3">Identificación</th>
                        <th class="py-3">Correo electrónico</th>
                        <th class="py-3">Rol</th>
                        <th class="py-3 text-center">Estado</th>
                        <th class="py-3 text-end pe-4">Acciones</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model?.Usuarios != null && Model.Usuarios.Any())
                    {
                        foreach (var u in Model.Usuarios)
                        {
                            var estaActivo = string.Equals(u.Estado, "Activo", StringComparison.OrdinalIgnoreCase);

                            var rolNormalizado = (u.TipoUsuario ?? string.Empty)
                                .Trim()
                                .ToLowerInvariant();

                            var claseRol = rolNormalizado switch
                            {
                                "administrador" => "role-admin",
                                "bibliotecario" => "role-librarian",
                                "docente" or "profesor" => "role-teacher",
                                "estudiante" => "role-student",
                                _ => "role-default"
                            };

                            var inicial = !string.IsNullOrWhiteSpace(u.NombreCompleto)
                                ? u.NombreCompleto.Trim()[0].ToString().ToUpperInvariant()
                                : "U";

                            <tr>
                                <td data-label="Usuario" class="user-name-cell ps-md-4">
                                    <div class="d-flex align-items-center gap-3 text-start">
                                        <span class="user-avatar-table">@inicial</span>

                                        <div>
                                            <div class="fw-semibold text-body-emphasis">@u.NombreCompleto</div>
                                            <div class="small text-body-secondary d-md-none">@u.Identificacion</div>
                                        </div>
                                    </div>
                                </td>

                                <td data-label="Identificación" class="text-body-secondary fw-medium">
                                    @u.Identificacion
                                </td>

                                <td data-label="Correo" class="text-body-secondary">
                                    @u.Correo
                                </td>

                                <td data-label="Rol">
                                    <span class="role-badge @claseRol">@u.TipoUsuario</span>
                                </td>

                                <td data-label="Estado" class="text-md-center">
                                    @if (estaActivo)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="bi bi-check-circle-fill"></i>Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="bi bi-x-circle-fill"></i>Inactivo
                                        </span>
                                    }
                                </td>

                                <td data-label="Acciones" class="actions-cell text-md-end pe-md-4">
                                    @if (User.IsInRole("Administrador"))
                                    {
                                        <div class="d-inline-flex gap-1">
                                            <a asp-action="Editar"
                                               asp-route-id="@u.UsuarioId"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Editar usuario"
                                               aria-label="Editar a @u.NombreCompleto">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>

                                            @if (estaActivo)
                                            {
                                                <a asp-action="Desactivar"
                                                   asp-route-id="@u.UsuarioId"
                                                   class="btn btn-sm btn-outline-danger"
                                                   title="Desactivar usuario"
                                                   aria-label="Desactivar a @u.NombreCompleto">
                                                    <i class="bi bi-person-x"></i>
                                                </a>
                                            }
                                            else
                                            {
                                                <a asp-action="Activar"
                                                   asp-route-id="@u.UsuarioId"
                                                   class="btn btn-sm btn-outline-success"
                                                   title="Activar usuario"
                                                   aria-label="Activar a @u.NombreCompleto">
                                                    <i class="bi bi-person-check"></i>
                                                </a>
                                            }
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-5 text-center">
                                <div class="empty-state-icon">
                                    <i class="bi bi-people fs-2"></i>
                                </div>

                                <h3 class="h5 fw-bold">No encontramos usuarios</h3>

                                <p class="text-body-secondary mb-3">
                                    Prueba con otra identificación o crea un usuario nuevo.
                                </p>

                                @if (User.IsInRole("Administrador"))
                                {
                                    <a asp-action="Crear" class="btn btn-primary">
                                        <i class="bi bi-person-plus me-1"></i>Crear usuario
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>