@model SIGEBI.AppWeb.Models.Usuarios.ActualizarUsuarioViewModel

@{
    ViewData["Title"] = "Editar Usuario";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-dark text-white p-4 rounded-top-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-pencil-square me-2"></i>Actualizar Usuario</h4>
                    <small class="text-white-50">Modifique la información del usuario en el sistema</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Editar" method="post">
                        <input type="hidden" asp-for="UsuarioId" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Identificacion" class="form-label fw-bold text-muted"></label>
                            <input asp-for="Identificacion" class="form-control form-control-lg bg-light" readonly />
                        </div>

                        <div class="mb-3">
                            <label asp-for="NombreCompleto" class="form-label fw-bold"></label>
                            <input asp-for="NombreCompleto" class="form-control form-control-lg" />
                            <span asp-validation-for="NombreCompleto" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label asp-for="Correo" class="form-label fw-bold text-muted"></label>
                                <input asp-for="Correo" class="form-control bg-light" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Tipo" class="form-label fw-bold text-muted"></label>
                                <input asp-for="Tipo" class="form-control bg-light" readonly />
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 pt-2">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-medium">Cancelar</a>
                            <button type="submit" class="btn btn-primary btn-lg fw-bold px-4">
                                <i class="bi bi-arrow-repeat me-1"></i>Actualizar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>