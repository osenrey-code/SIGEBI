@model SIGEBI.AppWeb.Models.Autth.LoginViewModel

@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5 col-lg-4">

            <div class="card shadow-sm border-0 rounded-3 mt-5">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-4">
                        <i class="bi bi-shield-lock-fill text-primary" style="font-size: 3rem;"></i>
                        <h3 class="fw-bold mt-2">SIGEBI</h3>
                        <p class="text-muted">Ingrese sus credenciales para acceder</p>
                    </div>

                    <form asp-action="Login" method="post">
                        <!-- Alerta estilizada con fondo suave y control de visibilidad inteligente -->
                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger p-3 small mb-4 rounded-3 border-0 bg-danger bg-opacity-10 text-danger shadow-sm"
                             role="alert"
                             style="display: @(ViewData.ModelState.IsValid ? "none" : "block")">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Identificacion" class="form-label fw-medium"></label>
                            <input asp-for="Identificacion" class="form-control form-control-lg" placeholder="Ej. 20230001" autofocus />
                            <span asp-validation-for="Identificacion" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-medium"></label>
                            <input asp-for="Password" class="form-control form-control-lg" placeholder="••••••••" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">
                            <i class="bi bi-box-arrow-in-right me-2"></i> Iniciar sesión
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <style>
        /* Oculta las viñetas predeterminadas de la lista de errores del validation summary */
        .alert ul {
            list-style-type: none;
            padding-left: 0;
            margin-bottom: 0;
        }

        .alert li {
            font-weight: 500;
        }
    </style>
}