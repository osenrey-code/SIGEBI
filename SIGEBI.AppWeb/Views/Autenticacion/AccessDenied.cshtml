@{
    ViewData["Title"] = "Acceso Denegado";
}

<div class="container py-5">
    <div class="row justify-content-center text-center">
        <div class="col-md-6 col-lg-5">
            <div class="card border border-secondary-subtle shadow-sm rounded-4 p-4 bg-body">
                <div class="card-body">
                    <!-- Ícono de Advertencia -->
                    <div class="bg-danger-subtle text-danger rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-shield-lock-fill display-4"></i>
                    </div>

                    <h3 class="fw-bold text-body-emphasis mb-2">Acceso Restringido</h3>
                    <p class="text-body-secondary mb-4">
                        Su cuenta actual no cuenta con los permisos necesarios para acceder a esta vista.
                    </p>

                    <!-- Acciones -->
                    <div class="d-grid gap-2">
                        <!-- Botón para cerrar sesión e iniciar con otro usuario -->
                        <form asp-controller="Autenticacion" asp-action="Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold shadow-sm">
                                <i class="bi bi-box-arrow-right me-2"></i> Cerrar Sesión y Cambiar Cuenta
                            </button>
                        </form>

                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                            Volver al Inicio
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>