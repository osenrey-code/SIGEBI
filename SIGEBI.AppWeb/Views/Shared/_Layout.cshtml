@using System.Security.Claims

@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var autenticado = User.Identity?.IsAuthenticated ?? false;
    var nombreUsuario = User.Identity?.Name ?? "Usuario";
    var inicialUsuario = !string.IsNullOrWhiteSpace(nombreUsuario)
        ? nombreUsuario.Trim()[0].ToString().ToUpperInvariant()
        : "U";

    var rolUsuario = User.FindFirst(ClaimTypes.Role)?.Value ?? string.Empty;
    var esAdministrador = User.IsInRole("Administrador");
    var esBibliotecario = User.IsInRole("Bibliotecario");
    var esAuditor = User.IsInRole("Auditor");
    var puedeGestionar = esAdministrador || esBibliotecario;
}

<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SIGEBI</title>

    <script>
        (() => {
            const tema = localStorage.getItem("sigebi_theme") || "light";
            document.documentElement.setAttribute("data-bs-theme", tema);
        })();
    </script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg app-navbar py-3">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Catalogo" asp-action="Index">
                    <span class="brand-mark">
                        <i class="bi bi-book-half fs-5"></i>
                    </span>

                    <span>
                        <span class="d-block brand-title">SIGEBI</span>
                        <small class="d-block brand-subtitle">Gestión bibliotecaria</small>
                    </span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú de navegación">
                    <i class="bi bi-list fs-2"></i>
                </button>

                <div class="collapse navbar-collapse mt-3 mt-lg-0" id="menuPrincipal">
                    <ul class="navbar-nav ms-lg-4 me-auto gap-lg-1">
                        
                        <!-- 🟢 CATÁLOGO ES PÚBLICO: Aparecerá siempre de primero -->
                        <li class="nav-item">
                            <a class="nav-link @(controladorActual.Equals("Catalogo", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                               asp-controller="Catalogo" asp-action="Index">
                                <i class="bi bi-bookshelf me-1"></i> Catálogo
                            </a>
                        </li>

                        @if (autenticado)
                        {
                            <!-- 🟢 INICIO: Solo se muestra si el usuario ha iniciado sesión -->
                            <li class="nav-item">
                                <a class="nav-link @(controladorActual.Equals("Home", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-grid-1x2 me-1"></i> Inicio
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(controladorActual.Equals("Prestamos", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-controller="Prestamos" asp-action="@(esAuditor ? "Historial" : "Index")">
                                    <i class="bi bi-arrow-left-right me-1"></i> Préstamos
                                </a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link @(controladorActual.Equals("Penalizaciones", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                   asp-controller="Penalizaciones" asp-action="Index">
                                    <i class="bi bi-exclamation-octagon me-1"></i> Penalizaciones
                                </a>
                            </li>

                            @if (puedeGestionar)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controladorActual.Equals("Categorias", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                       asp-controller="Categorias" asp-action="Index">
                                        <i class="bi bi-tags me-1"></i> Categorías
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link @(controladorActual.Equals("Devoluciones", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                       asp-controller="Devoluciones" asp-action="Index">
                                        <i class="bi bi-box-arrow-in-left me-1"></i> Devoluciones
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link @(controladorActual.Equals("Reportes", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                       asp-controller="Reportes" asp-action="Index">
                                        <i class="bi bi-bar-chart-line me-1"></i> Reportes
                                    </a>
                                </li>

                                <li class="nav-item">
                                    <a class="nav-link @(controladorActual.Equals("Usuarios", StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                       asp-controller="Usuarios" asp-action="Index">
                                        <i class="bi bi-people me-1"></i> Usuarios
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 pt-3 pt-lg-0">
                        <button id="btnSwitchTheme" class="theme-toggle me-1" type="button"
                                title="Cambiar tema" aria-label="Cambiar tema">
                            <i id="themeIcon" class="bi bi-moon-stars-fill"></i>
                        </button>

                        @if (autenticado)
                        {
                            <!-- INICIO: Menú de Notificaciones -->
                            <div class="dropdown me-2">
                                <button class="btn border-0 shadow-none p-2 position-relative text-reset" type="button" id="menuNotificaciones" data-bs-toggle="dropdown" aria-expanded="false" title="Notificaciones">
                                    <i class="bi bi-bell fs-5"></i>
                                    <span class="position-absolute top-25 start-75 translate-middle badge rounded-pill bg-danger" style="font-size: 0.65em; display: none;">
                                        0
                                    </span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow mt-2" aria-labelledby="menuNotificaciones" style="width: 320px; max-height: 420px; overflow-y: auto;">
                                    <li>
                                        <div class="dropdown-header d-flex justify-content-between align-items-center fw-bold">
                                            <span>Notificaciones sin leer</span>
                                            <a href="javascript:void(0)" id="btnMarcarTodasLeidas" class="text-decoration-none small">Marcar leídas</a>
                                        </div>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <div class="text-center text-muted py-3 small">
                                            Cargando notificaciones...
                                        </div>
                                    </li>
                                </ul>
                            </div>
                            <!-- FIN: Menú de Notificaciones -->

                            <div class="dropdown">
                                <button class="user-menu d-flex align-items-center gap-2 px-2 py-1 rounded-3"
                                        type="button"
                                        id="menuUsuario"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <span class="user-avatar">@inicialUsuario</span>

                                    <span class="d-none d-sm-block text-start">
                                        <span class="d-block fw-semibold small">@nombreUsuario</span>
                                        <span class="d-block user-role">@rolUsuario</span>
                                    </span>

                                    <i class="bi bi-chevron-down small"></i>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end mt-2" aria-labelledby="menuUsuario">
                                    <li class="px-3 py-2 border-bottom">
                                        <div class="fw-semibold">@nombreUsuario</div>
                                        <div class="small text-body-secondary mt-1">@rolUsuario</div>
                                    </li>

                                    <li class="mt-1">
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Usuarios" asp-action="MiPerfil">
                                            <i class="bi bi-person me-2"></i>Mi Perfil
                                        </a>
                                    </li>

                                    <li class="mt-1">
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Prestamos" asp-action="@(esAuditor ? "Historial" : "Index")">
                                            <i class="bi bi-journal-bookmark me-2"></i>Mis Préstamos
                                        </a>
                                    </li>

                                    <li class="mt-1">
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Penalizaciones" asp-action="Index">
                                            <i class="bi bi-exclamation-octagon me-2"></i>Mis Penalizaciones
                                        </a>
                                    </li>

                                    <li class="mt-1">
                                        <form asp-controller="Autenticacion" asp-action="Logout" method="post">
                                            <button type="submit" class="dropdown-item rounded-3 text-danger py-2">
                                                <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <!-- 🟢 INICIAR SESIÓN: Se muestra cuando NO están autenticados -->
                            <a class="btn btn-primary px-3 rounded-3 fw-semibold shadow-sm"
                               asp-controller="Autenticacion"
                               asp-action="Login">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-main flex-grow-1 py-4 py-lg-5">
        <div class="page-container px-3 px-lg-4">
            @RenderBody()
        </div>
    </main>

    <footer class="app-footer mt-auto py-4">
        <div class="container-fluid px-3 px-lg-4 d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 small">
            <span>&copy; 2026 <strong>SIGEBI</strong> · Sistema de Gestión Bibliotecaria</span>

            <a asp-controller="Home" asp-action="Privacy" class="text-decoration-none">
                Privacidad
            </a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // --- LÓGICA DEL TEMA ---
            const botonTema = document.getElementById("btnSwitchTheme");
            const iconoTema = document.getElementById("themeIcon");

            const actualizarTema = (tema) => {
                document.documentElement.setAttribute("data-bs-theme", tema);
                localStorage.setItem("sigebi_theme", tema);
                const oscuro = tema === "dark";
                if (iconoTema) {
                    iconoTema.className = oscuro ? "bi bi-sun-fill text-warning" : "bi bi-moon-stars-fill";
                }
                if (botonTema) {
                    botonTema.title = oscuro ? "Usar tema claro" : "Usar tema oscuro";
                }
            };

            const temaActual = document.documentElement.getAttribute("data-bs-theme") || "light";
            actualizarTema(temaActual);

            if (botonTema) {
                botonTema.addEventListener("click", () => {
                    const temaEnCurso = document.documentElement.getAttribute("data-bs-theme");
                    actualizarTema(temaEnCurso === "dark" ? "light" : "dark");
                });
            }

            // --- LÓGICA DE NOTIFICACIONES ---
            const cargarNotificaciones = () => {
                const badge = document.querySelector('#menuNotificaciones .badge');
                const lista = document.querySelector('[aria-labelledby="menuNotificaciones"]');

                if (!badge || !lista) return;

                fetch('/Notificacion/ObtenerMisNotificaciones')
                    .then(response => response.json())
                    .then(data => {
                        const noLeidas = data.filter(n => !(n.leida ?? n.Leida));

                        if (noLeidas.length > 0) {
                            badge.textContent = noLeidas.length;
                            badge.style.display = 'block';
                        } else {
                            badge.style.display = 'none';
                        }

                        const headerHtml = `
                            <li>
                                <div class="dropdown-header d-flex justify-content-between align-items-center fw-bold">
                                    <span>Notificaciones sin leer</span>
                                    <a href="javascript:void(0)" id="btnMarcarTodasLeidas" class="text-decoration-none small">Marcar leídas</a>
                                </div>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                        `;

                        const footerHtml = `
                            <li><hr class="dropdown-divider my-1"></li>
                            <li>
                                <a class="dropdown-item text-center text-primary fw-bold small py-2" href="/Notificacion/Index">
                                    Ver todas las notificaciones <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </li>
                        `;

                        if (!noLeidas || noLeidas.length === 0) {
                            lista.innerHTML = headerHtml + `<li><div class="text-center text-muted py-4 small"><i class="bi bi-check2-all me-1"></i>No tienes notificaciones pendientes.</div></li>` + footerHtml;
                            return;
                        }

                        let itemsHtml = '';
                        noLeidas.forEach(n => {
                            const id = n.notificacionId ?? n.NotificacionId;
                            const tipo = n.tipo ?? n.Tipo ?? 'Info';
                            const mensaje = n.mensaje ?? n.Mensaje ?? '';
                            const fecha = n.fechaRegistro ?? n.FechaRegistro;

                            const fechaObj = new Date(fecha);
                            const fechaFmt = !isNaN(fechaObj)
                                ? fechaObj.toLocaleDateString() + ' ' + fechaObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
                                : '';

                            itemsHtml += `
                                <li class="border-bottom bg-body-secondary">
                                    <a class="dropdown-item py-2 text-wrap item-notificacion" href="/Notificacion/Detalles/${id}">
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <span class="badge bg-primary bg-opacity-20 text-primary rounded-pill" style="font-size: 0.65em;">${tipo}</span>
                                            <small class="text-muted" style="font-size: 0.7em;">${fechaFmt}</small>
                                        </div>
                                        <span class="d-block small fw-semibold text-body-emphasis">${mensaje}</span>
                                    </a>
                                </li>
                            `;
                        });

                        lista.innerHTML = headerHtml + itemsHtml + footerHtml;

                        // Evento "Marcar todas como leídas"
                        const btnMarcar = document.getElementById('btnMarcarTodasLeidas');
                        if (btnMarcar) {
                            btnMarcar.addEventListener('click', (e) => {
                                e.stopPropagation();
                                const promesas = noLeidas.map(n => {
                                    const id = n.notificacionId ?? n.NotificacionId;
                                    return fetch(`/Notificacion/MarcarLeida?id=${id}`, { method: 'POST' });
                                });
                                Promise.all(promesas).then(() => cargarNotificaciones());
                            });
                        }
                    })
                    .catch(error => {
                        console.error('Error al cargar notificaciones:', error);
                        if (lista) {
                            lista.innerHTML = `<li><div class="text-center text-muted py-3 small">Error al cargar notificaciones</div></li>`;
                        }
                    });
            };

            cargarNotificaciones();
        });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>