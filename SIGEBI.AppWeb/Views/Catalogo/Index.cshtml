@model SIGEBI.AppWeb.Models.ViewModels.Catalogo.CatalogoIndexViewModel

@{
    ViewData["Title"] = "Catálogo de Recursos Bibliográficos";
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Catálogo</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-bookshelf me-2"></i>Catálogo de Recursos</h1>
            <p class="hero-description mb-0">Consulta la disponibilidad de libros organizada por categorías y gestiona tus préstamos.</p>
        </div>
    </div>
</div>

<!-- ALERTAS DE SISTEMA -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success border-0 bg-success-subtle text-success alert-dismissible fade show rounded-4 p-3 mb-4 d-flex align-items-center justify-content-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-check-circle-fill fs-5 flex-shrink-0"></i>
        <span class="fw-semibold text-center mb-0">@TempData["Success"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-danger border-0 bg-danger-subtle text-danger alert-dismissible fade show rounded-4 p-3 mb-4 d-flex align-items-center justify-content-center gap-2 shadow-sm" role="alert">
        <i class="bi bi-exclamation-triangle-fill fs-5 flex-shrink-0"></i>
        <span class="fw-semibold text-center mb-0">@TempData["Error"]</span>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

<!-- Buscador de Recursos -->
<div class="content-card card shadow-sm rounded-4 border-0 mb-5">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group input-group-lg">
                    <span class="input-group-text border-end-0 bg-transparent"><i class="bi bi-search text-body-secondary"></i></span>
                    <input type="text" id="inputBuscador" name="Titulo" class="form-control border-start-0 fs-6 shadow-none" placeholder="Buscar por título, autor o ISBN..." value="@Model?.Titulo" onkeyup="filtrarEstanteriaLocal()" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg fs-6 w-100 fw-semibold">
                    <i class="bi bi-search me-1"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg fs-6 w-100 fw-semibold">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- ESTANTERÍA DE RECURSOS (AGRUPADOS POR CATEGORÍA) -->
@if (Model?.Recursos != null && Model.Recursos.Any())
{
    var gruposCategoria = Model.Recursos.GroupBy(x => string.IsNullOrWhiteSpace(x.Categoria) ? "Sin Categoría" : x.Categoria);

    foreach (var grupo in gruposCategoria)
    {
        <div class="seccion-categoria mb-5">
            <!-- TÍTULO DE LA CATEGORÍA -->
            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom border-secondary border-opacity-10">
                <h4 class="fw-bold text-body-emphasis m-0 d-flex align-items-center gap-2">
                    <i class="bi bi-tag-fill text-primary"></i> @grupo.Key
                </h4>
            </div>

            <!-- FILA DE TARJETAS TIPO LIBRO -->
            <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-lg-5 row-cols-xl-6 g-3 g-md-4">
                @foreach (var item in grupo)
                {
                    <div class="col tarjeta-libro-item" data-titulo="@item.Titulo.ToLower()" data-autor="@item.Autor.ToLower()" data-isbn="@(item.ISBN?.ToLower() ?? "")">
                        <div class="card h-100 border-0 content-card shadow-sm position-relative overflow-hidden tarjeta-portada rounded-4">

                            <!-- CONTENEDOR DE PORTADA -->
                            <div class="portada-wrapper position-relative">
                                @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                {
                                    <img src="@item.ImagenUrl" alt="Portada de @item.Titulo" class="portada-img" />
                                }
                                else
                                {
                                    <div class="portada-placeholder d-flex flex-column align-items-center justify-content-center p-3 text-center">
                                        <i class="bi bi-journal-bookmark text-primary fs-1 mb-2 opacity-50"></i>
                                        <span class="fw-bold small text-body-emphasis line-clamp-2">@item.Titulo</span>
                                    </div>
                                }
                            </div>

                            <!-- INFORMACIÓN DEL LIBRO -->
                            <div class="card-body p-3 d-flex flex-column justify-content-between">
                                <div>
                                    <h6 class="fw-bold text-body-emphasis line-clamp-1 mb-1" title="@item.Titulo">
                                        @item.Titulo
                                    </h6>
                                    <p class="small text-body-secondary line-clamp-1 mb-1" title="@item.Autor">
                                        <i class="bi bi-person me-1"></i>@item.Autor
                                    </p>
                                    <p class="font-monospace text-body-tertiary extra-small mb-2">
                                        ISBN: @(string.IsNullOrWhiteSpace(item.ISBN) ? "-" : item.ISBN)
                                    </p>

                                    <!-- DISPONIBILIDAD -->
                                    <div class="mb-2">
                                        <span class="badge @(item.CopiasDisponibles > 0 ? "text-bg-success" : "text-bg-danger") fw-semibold extra-small">
                                            <i class="bi @(item.CopiasDisponibles > 0 ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                            @(item.CopiasDisponibles > 0 ? $"{item.CopiasDisponibles}/{item.TotalEjemplares} Disp." : "Agotado")
                                        </span>
                                    </div>
                                </div>

                                <!-- ACCIONES -->
                                <div class="mt-2 pt-2 border-top border-secondary border-opacity-10 d-flex flex-column gap-1">
                                    <a asp-action="Detalles" asp-route-id="@item.RecursoBibliograficoId"
                                       class="btn btn-sm btn-outline-secondary w-100 mb-1 rounded-2 fw-semibold">
                                        <i class="bi bi-eye me-1"></i> Detalle
                                    </a>

                                    @if (item.CopiasDisponibles > 0)
                                    {
                                        <!-- Envia el ID real del ejemplar físico disponible -->
                                        <a asp-controller="Solicitudes" asp-action="Solicitar" asp-route-ejemplarId="@item.EjemplarDisponibleId"
                                           class="btn btn-sm btn-primary w-100 rounded-2 fw-bold d-flex align-items-center justify-content-center gap-1">
                                            <i class="bi bi-bookmark-plus"></i> Solicitar
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 rounded-2 fw-semibold opacity-50" disabled>
                                            Agotado
                                        </button>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                }
            </div>
        </div>
    }
}
else
{
    <div class="content-card card border-0 shadow-sm rounded-4 p-5 text-center my-4">
        <i class="bi bi-journal-x fs-1 d-block mb-3 text-body-tertiary"></i>
        <h4 class="fw-bold text-body-emphasis">No se encontraron recursos bibliográficos</h4>
        <p class="text-body-secondary mb-0">No hay libros registrados que coincidan con el criterio de búsqueda.</p>
    </div>
}

<!-- ESTILOS Y ANIMACIONES -->
<style>
    .portada-wrapper {
        aspect-ratio: 2 / 3;
        width: 100%;
        background-color: rgba(0, 0, 0, 0.04);
        overflow: hidden;
    }

    [data-bs-theme="dark"] .portada-wrapper {
        background-color: rgba(255, 255, 255, 0.05);
    }

    .portada-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: transform 0.3s ease;
    }

    .portada-placeholder {
        height: 100%;
        background: linear-gradient(135deg, rgba(13, 110, 253, 0.05), rgba(13, 110, 253, 0.12));
    }

    .tarjeta-portada {
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .tarjeta-portada:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 24px rgba(0, 0, 0, 0.15) !important;
    }

    .tarjeta-portada:hover .portada-img {
        transform: scale(1.05);
    }

    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .extra-small {
        font-size: 0.72rem;
    }
</style>

@section Scripts {
    <script>
        function filtrarEstanteriaLocal() {
            const query = document.getElementById('inputBuscador').value.toLowerCase().trim();
            const tarjetas = document.querySelectorAll('.tarjeta-libro-item');
            const secciones = document.querySelectorAll('.seccion-categoria');

            tarjetas.forEach(tarjeta => {
                const titulo = tarjeta.getAttribute('data-titulo') || '';
                const autor = tarjeta.getAttribute('data-autor') || '';
                const isbn = tarjeta.getAttribute('data-isbn') || '';

                if (titulo.includes(query) || autor.includes(query) || isbn.includes(query)) {
                    tarjeta.classList.remove('d-none');
                } else {
                    tarjeta.classList.add('d-none');
                }
            });

            secciones.forEach(seccion => {
                const visibles = seccion.querySelectorAll('.tarjeta-libro-item:not(.d-none)');
                if (visibles.length === 0 && query !== '') {
                    seccion.classList.add('d-none');
                } else {
                    seccion.classList.remove('d-none');
                }
            });
        }
    </script>
}