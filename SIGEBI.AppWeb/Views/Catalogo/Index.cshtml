@using System.Security.Claims
@model IEnumerable<SIGEBI.Application.DTOs.Response.RecursoResponse>

@{
    ViewData["Title"] = "Catálogo de Recursos Bibliográficos";

    var esAdministrador = User.IsInRole("Administrador");
    var esBibliotecario = User.IsInRole("Bibliotecario");
    var puedeGestionar = esAdministrador || esBibliotecario;
}

<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Catálogo</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-book me-2"></i>Catálogo de Recursos</h1>
            <p class="hero-description mb-0">Consulta la disponibilidad de libros y gestiona tus solicitudes de préstamo.</p>
        </div>

        @* Solo visible para Administrador y Bibliotecario *@
        @if (puedeGestionar)
        {
            <div>
                <a asp-action="Crear" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-plus-lg"></i> Nuevo Registro
                </a>
            </div>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Buscador de Recursos -->
<div class="content-card card shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group input-group-lg">
                    <span class="input-group-text border-end-0 bg-transparent"><i class="bi bi-search text-body-secondary"></i></span>
                    <input type="text" name="Titulo" class="form-control border-start-0 fs-6" placeholder="Buscar por título, autor o ISBN..." value="@Context.Request.Query["Titulo"]" />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg fs-6 w-100 fw-semibold">
                    <i class="bi bi-search me-1"></i> Buscar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg fs-6 w-100 fw-semibold">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de Recursos Bibliográficos -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th class="ps-4">PORTADA</th>
                    <th>TÍTULO & AUTOR</th>
                    <th>ISBN</th>
                    <th>CATEGORÍA</th>
                    <th class="text-center">DISPONIBILIDAD</th>
                    <th class="text-end pe-4">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="PORTADA" class="ps-4">
                                @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                {
                                    <img src="@item.ImagenUrl" alt="Portada de @item.Titulo" class="img-thumbnail rounded shadow-sm" style="width: 48px; height: 68px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center border" style="width: 48px; height: 68px;">
                                        <i class="bi bi-journal-bookmark text-secondary fs-4"></i>
                                    </div>
                                }
                            </td>
                            <td data-label="TÍTULO & AUTOR" class="fw-bold text-body-emphasis">
                                @item.Titulo
                                <br />
                                <span class="text-body-secondary fw-normal" style="font-size: 0.85em;">
                                    <i class="bi bi-person me-1"></i>@item.Autor
                                </span>
                            </td>
                            <td data-label="ISBN" class="text-body-secondary font-monospace">@item.ISBN</td>

                            <!-- Categoría -->
                            <td data-label="CATEGORÍA">
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                    <i class="bi bi-tag-fill me-1"></i>@item.Categoria
                                </span>
                            </td>

                            <td data-label="DISPONIBILIDAD" class="text-center">
                                <span class="badge @(item.CopiasDisponibles > 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-3 py-2 rounded-pill fw-semibold">
                                    <i class="bi @(item.CopiasDisponibles > 0 ? "bi-check-circle-fill" : "bi-x-circle-fill") me-1"></i>
                                    @item.CopiasDisponibles / @item.TotalEjemplares Disponibles
                                </span>
                            </td>

                            <td data-label="ACCIONES" class="text-end pe-4">
                                <div class="d-inline-flex gap-1 align-items-center" role="group">
                                    <!-- Ver Detalles (Todos los usuarios) -->
                                    <a asp-action="Detalles" asp-route-id="@item.RecursoBibliograficoId"
                                       class="btn btn-sm btn-outline-primary rounded-2 px-2 py-1"
                                       title="Ver Detalles y Ejemplares">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    @* Edición e Historial: Administrador y Bibliotecario *@
                                    @if (puedeGestionar)
                                    {
                                        <a asp-action="Editar" asp-route-id="@item.RecursoBibliograficoId"
                                           class="btn btn-sm btn-outline-secondary rounded-2 px-2 py-1"
                                           title="Editar Recurso">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <a asp-action="Historial" asp-route-id="@item.RecursoBibliograficoId"
                                           class="btn btn-sm btn-outline-info rounded-2 px-2 py-1"
                                           title="Ver Historial de Movimientos">
                                            <i class="bi bi-clock-history"></i>
                                        </a>
                                    }

                                    @* Eliminar: EXCLUSIVO para el Administrador *@
                                    @if (esAdministrador)
                                    {
                                        <button type="button"
                                                class="btn btn-sm btn-outline-danger rounded-2 px-2 py-1"
                                                onclick="prepararEliminacion(@item.RecursoBibliograficoId, '@item.Titulo')"
                                                title="Eliminar Recurso">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }

                                    @* Solicitar Préstamo: Estudiante / Docente *@
                                    @if (!puedeGestionar)
                                    {
                                        @if (item.CopiasDisponibles > 0)
                                        {
                                            <a asp-controller="Solicitudes" asp-action="Solicitar" asp-route-ejemplarId="@item.RecursoBibliograficoId"
                                               class="btn btn-sm btn-primary rounded-2 px-3 py-1 fw-semibold d-inline-flex align-items-center gap-1"
                                               title="Solicitar Préstamo">
                                                <i class="bi bi-bookmark-plus"></i> Solicitar
                                            </a>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-2 px-3 py-1 fw-semibold opacity-50" disabled title="Sin ejemplares disponibles">
                                                Agotado
                                            </button>
                                        }
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-body-secondary">
                            <i class="bi bi-journal-x fs-1 d-block mb-2 text-body-tertiary"></i>
                            <span>No se encontraron recursos bibliográficos registrados.</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* El modal de eliminación SOLO se renderiza en el DOM si es Administrador *@
@if (esAdministrador)
{
    <!-- Modal Adaptable (Tema Claro / Tema Oscuro) -->
    <div class="modal fade" id="modalEliminarRecurso" tabindex="-1" aria-labelledby="modalEliminarLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-danger text-white border-0 py-3">
                    <h5 class="modal-title fw-bold" id="modalEliminarLabel">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Eliminar Recurso Bibliográfico
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="Eliminar" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <input type="hidden" id="eliminarRecursoId" name="recursoBibliograficoId" />

                        <p class="mb-3 text-body-emphasis fw-semibold">
                            ¿Estás seguro de que deseas dar de baja el recurso <span id="eliminarRecursoTitulo" class="text-danger fw-bold"></span>?
                        </p>
                        <p class="text-body-secondary small mb-4">
                            Esta acción registrará la baja en el historial de auditoría del sistema. El recurso solo podrá ser eliminado si no tiene préstamos activos.
                        </p>

                        <div class="mb-3">
                            <label for="motivoBaja" class="form-label fw-bold text-body-emphasis">Motivo de la Baja (Obligatorio)</label>
                            <textarea id="motivoBaja" name="motivo" class="form-control" rows="3" placeholder="Ej. Material sumamente deteriorado, pérdida o baja del catálogo." required></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-top border-secondary border-opacity-10 px-4 py-3">
                        <button type="button" class="btn btn-outline-secondary fw-semibold" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-danger fw-semibold px-4">
                            <i class="bi bi-trash me-1"></i> Confirmar Eliminación
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    @if (esAdministrador)
    {
        <script>
            function prepararEliminacion(id, titulo) {
                document.getElementById('eliminarRecursoId').value = id;
                document.getElementById('eliminarRecursoTitulo').innerText = "'" + titulo + "'";
                document.getElementById('motivoBaja').value = '';

                var modal = new bootstrap.Modal(document.getElementById('modalEliminarRecurso'));
                modal.show();
            }
        </script>
    }
}