@using System.Security.Claims
@model SIGEBI.Application.DTOs.Response.RecursoResponse

@{
    ViewData["Title"] = "Detalles del Recurso";

    var esAdministrador = User.IsInRole("Administrador");
    var esBibliotecario = User.IsInRole("Bibliotecario");
    var esAuditor = User.IsInRole("Auditor");

    var puedeEditar = esAdministrador || esBibliotecario;
    var puedeVerAuditoria = esAdministrador || esAuditor;
    var puedeGestionar = esAdministrador || esBibliotecario;
}

<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Catálogo</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-info-circle-fill me-2"></i>Detalles del Recurso</h1>
            <p class="hero-description mb-0">Información general, portadas y estado de disponibilidad de los ejemplares.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-light text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Volver al Listado
            </a>

            @* Solo visible para Administrador y Bibliotecario *@
            @if (Model != null && puedeEditar)
            {
                <a asp-action="Editar" asp-route-id="@Model.RecursoBibliograficoId" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                    <i class="bi bi-pencil"></i> Editar
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model == null)
{
    <div class="alert alert-warning border-0 shadow-sm rounded-3 my-4 p-4" role="alert">
        <h4 class="alert-heading fw-bold"><i class="bi bi-exclamation-triangle me-2"></i>Recurso no encontrado</h4>
        <p class="mb-0">No se pudo cargar la información del recurso bibliográfico seleccionado.</p>
        <hr />
        <a asp-action="Index" class="btn btn-outline-dark fw-semibold mt-2">Volver al Catálogo</a>
    </div>
}
else
{
    <div class="row g-4">
        <!-- Columna Izquierda: Portada del Libro -->
        <div class="col-lg-4">
            <div class="content-card card shadow-sm rounded-4 text-center p-4 h-100 d-flex flex-column justify-content-between">
                <div class="my-auto py-3">
                    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
                    {
                        <img src="@Model.ImagenUrl" alt="Portada de @Model.Titulo" class="img-fluid rounded shadow-sm border" style="max-height: 350px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="bg-secondary bg-opacity-10 rounded d-flex flex-column align-items-center justify-content-center border mx-auto py-5" style="width: 200px; height: 280px;">
                            <i class="bi bi-journal-bookmark text-secondary display-1 mb-2"></i>
                            <span class="text-body-secondary small">Sin portada</span>
                        </div>
                    }
                </div>

                <div class="mt-3 border-top border-secondary border-opacity-10 pt-3 text-start">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-body-secondary fw-semibold">ID Interno:</span>
                        <span class="fw-bold text-body-emphasis font-monospace">#@Model.RecursoBibliograficoId</span>
                    </div>

                    @* Historial / Auditoría: SOLO visible para Administrador y Auditor *@
                    @if (puedeVerAuditoria)
                    {
                        <div class="d-flex justify-content-between pt-2 border-top border-secondary border-opacity-10">
                            <span class="text-body-secondary fw-semibold">Historial:</span>
                            <a asp-action="Historial" asp-route-id="@Model.RecursoBibliograficoId" class="text-decoration-none fw-semibold">
                                <i class="bi bi-clock-history me-1"></i> Ver auditoría
                            </a>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Información y Disponibilidad -->
        <div class="col-lg-8">
            <div class="content-card card shadow-sm rounded-4 p-4 p-lg-5 h-100 d-flex flex-column justify-content-between">
                <div>
                    <div class="mb-3">
                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold mb-2">
                            <i class="bi bi-tag-fill me-1"></i> @Model.Categoria
                        </span>
                        <h2 class="fw-bold text-body-emphasis mb-1">@Model.Titulo</h2>
                        <p class="text-body-secondary fs-5 mb-4">por <span class="fw-semibold text-body-emphasis">@Model.Autor</span></p>
                    </div>

                    <div class="row g-4 border-top border-bottom border-secondary border-opacity-10 py-4 mb-4">
                        <div class="col-sm-4">
                            <span class="d-block text-body-secondary small fw-semibold text-uppercase mb-1">ISBN</span>
                            <span class="fs-6 fw-bold font-monospace text-body-emphasis">@(string.IsNullOrWhiteSpace(Model.ISBN) ? "-" : Model.ISBN)</span>
                        </div>
                        <div class="col-sm-4">
                            <span class="d-block text-body-secondary small fw-semibold text-uppercase mb-1">Año de Publicación</span>
                            <span class="fs-6 fw-bold text-body-emphasis">@(Model.AnioPublicado > 0 ? Model.AnioPublicado.ToString() : "-")</span>
                        </div>
                        <div class="col-sm-4">
                            <span class="d-block text-body-secondary small fw-semibold text-uppercase mb-1">Disponibilidad General</span>
                            <span class="badge @(Model.CopiasDisponibles > 0 ? "bg-success-subtle text-success border border-success-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") px-3 py-1.5 rounded-pill fw-semibold">
                                @Model.CopiasDisponibles / @Model.TotalEjemplares Disponibles
                            </span>
                        </div>
                    </div>

                    @* Nota sobre Gestión de Ejemplares: SOLO visible para Administradores y Bibliotecarios *@
                    @if (puedeGestionar)
                    {
                        <div class="alert alert-info border-0 shadow-sm rounded-3 mb-0" role="alert">
                            <div class="d-flex">
                                <i class="bi bi-info-circle-fill fs-5 me-2 text-info"></i>
                                <div class="small">
                                    <strong>Gestión de Ejemplares:</strong> Los ejemplares individuales de este recurso se generan automáticamente según la cantidad ingresada al registrar el libro. Puedes consultar o modificar el estado de cada ejemplar en el módulo de préstamos o mediante la administración de estados.
                                </div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Botones de Acción Inferiores -->
                <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top border-secondary border-opacity-10">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-semibold px-4">Regresar al Catálogo</a>

                    @* Si es Estudiante, Docente o Auditor (No gestionan catálogo), habilitamos el botón de Solicitar *@
                    @if (!puedeGestionar)
                    {
                        @if (Model.CopiasDisponibles > 0)
                        {
                            <a asp-controller="Solicitudes" asp-action="Solicitar" asp-route-ejemplarId="@Model.RecursoBibliograficoId"
                               class="btn btn-primary btn-lg fw-semibold px-4 d-inline-flex align-items-center gap-2">
                                <i class="bi bi-bookmark-plus-fill"></i> Solicitar Préstamo
                            </a>
                        }
                        else
                        {
                            <button type="button" class="btn btn-secondary btn-lg fw-semibold px-4 opacity-50" disabled>
                                Sin ejemplares disponibles
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}