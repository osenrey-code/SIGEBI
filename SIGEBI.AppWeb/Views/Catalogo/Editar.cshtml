@model SIGEBI.AppWeb.Models.Catalogo.ActualizarRecursoViewModel

@{
    ViewData["Title"] = "Editar Recurso Bibliográfico";
    var categorias = ViewBag.Categorias as IEnumerable<SIGEBI.Application.DTOs.Response.CategoriaResponse> ?? new List<SIGEBI.Application.DTOs.Response.CategoriaResponse>();
}

<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Catálogo</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-pencil-square me-2"></i>Editar Recurso</h1>
            <p class="hero-description mb-0">Modifica los datos del libro o actualiza su portada en el catálogo.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Volver al Listado
            </a>
        </div>
    </div>
</div>

<div class="content-card card shadow-sm rounded-4 mb-4">
    <div class="card-body p-4 p-lg-5">
        <form asp-action="Editar" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <input type="hidden" asp-for="RecursoBibliograficoId" />
            <input type="hidden" asp-for="ImagenUrlActual" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert"></div>

            <div class="row g-4">
                <div class="col-md-6">
                    <label asp-for="Titulo" class="form-label fw-bold text-body-emphasis">Título del Recurso</label>
                    <input asp-for="Titulo" class="form-control form-control-lg" required />
                    <span asp-validation-for="Titulo" class="text-danger small"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Autor" class="form-label fw-bold text-body-emphasis">Autor</label>
                    <input asp-for="Autor" class="form-control form-control-lg" required />
                    <span asp-validation-for="Autor" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="ISBN" class="form-label fw-bold text-body-emphasis">ISBN (No modificable)</label>
                    <input asp-for="ISBN" class="form-control form-control-lg bg-light" readonly />
                    <span class="form-text text-muted">El ISBN no se puede alterar una vez registrado.</span>
                </div>

                <div class="col-md-4">
                    <label asp-for="CategoriaId" class="form-label fw-bold text-body-emphasis">Categoría</label>
                    <select asp-for="CategoriaId" class="form-select form-select-lg" required>
                        <option value="">-- Seleccionar Categoría --</option>
                        @foreach (var cat in categorias)
                        {
                            <option value="@cat.CategoriaId">@cat.Nombre</option>
                        }
                    </select>
                    <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                </div>

                <div class="col-md-4">
                    <label asp-for="AnioPublicado" class="form-label fw-bold text-body-emphasis">Año de Publicación</label>
                    <input asp-for="AnioPublicado" type="number" class="form-control form-control-lg" required />
                    <span asp-validation-for="AnioPublicado" class="text-danger small"></span>
                </div>

                <!-- Sección de Portada -->
                <div class="col-12 border-top pt-4 mt-4">
                    <div class="row g-4 align-items-center">
                        <div class="col-md-3 text-center">
                            <label class="form-label fw-bold text-body-emphasis d-block">Portada Actual</label>
                            @if (!string.IsNullOrEmpty(Model.ImagenUrlActual))
                            {
                                <img id="imgActual" src="@Model.ImagenUrlActual" alt="Portada actual" class="img-thumbnail rounded shadow-sm" style="max-height: 180px; object-fit: cover;" />
                            }
                            else
                            {
                                <div class="bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center border py-4">
                                    <i class="bi bi-journal-bookmark text-secondary fs-1"></i>
                                </div>
                            }
                        </div>

                        <div class="col-md-9">
                            <label asp-for="NuevaImagen" class="form-label fw-bold text-body-emphasis">Cambiar Portada / Imagen (Opcional)</label>
                            <input asp-for="NuevaImagen" id="inputNuevaImagen" type="file" class="form-control form-control-lg" accept="image/png, image/jpeg, image/jpg, image/webp" />
                            <div class="form-text text-body-secondary">Si seleccionas un nuevo archivo, reemplazará la portada actual. Formatos: JPG, PNG, WEBP.</div>
                            <span asp-validation-for="NuevaImagen" class="text-danger small"></span>

                            <div id="previewNuevaContainer" class="mt-3 d-none">
                                <label class="form-label fw-semibold text-primary d-block">Vista previa de la nueva portada:</label>
                                <img id="imgNuevaPreview" src="#" alt="Nueva Portada" class="img-thumbnail rounded shadow-sm border-primary" style="max-height: 150px;" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-5 border-top pt-4">
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-semibold px-4">Cancelar</a>
                <button type="submit" class="btn btn-primary btn-lg fw-semibold px-5">
                    <i class="bi bi-arrow-repeat me-1"></i> Actualizar Recurso
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        // Previsualizador dinámico de la nueva imagen seleccionada
        document.getElementById('inputNuevaImagen').addEventListener('change', function(e) {
            const file = e.target.files[0];
            const previewContainer = document.getElementById('previewNuevaContainer');
            const imgPreview = document.getElementById('imgNuevaPreview');

            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    imgPreview.src = e.target.result;
                    previewContainer.classList.remove('d-none');
                }
                reader.readAsDataURL(file);
            } else {
                imgPreview.src = '#';
                previewContainer.classList.add('d-none');
            }
        });
    </script>
}