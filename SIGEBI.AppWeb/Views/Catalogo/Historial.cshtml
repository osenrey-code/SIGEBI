@model IEnumerable<SIGEBI.Application.DTOs.Response.HistorialRecursoResponse>

@{
    ViewData["Title"] = "Historial de Auditoría";
}

<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Catálogo</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-clock-history me-2"></i>Historial de Auditoría</h1>
            <p class="hero-description mb-0">Registro cronológico de modificaciones, cambios de estado y eventos sobre este recurso.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-light text-white fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-arrow-left"></i> Volver al Catálogo
            </a>
        </div>
    </div>
</div>

<div class="content-card card shadow-sm rounded-4 mb-4">
    <div class="card-body p-4 p-lg-5">
        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-journal-x text-muted display-4 mb-3 d-block"></i>
                <h5 class="fw-bold text-body-emphasis">Sin registros de auditoría</h5>
                <p class="text-muted mb-0">No se encontraron eventos o modificaciones registradas para este recurso bibliográfico.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Fecha y Hora</th>
                            <th scope="col">Tipo de Cambio</th>
                            <th scope="col">Usuario Responsable</th>
                            <th scope="col">Detalles</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-semibold text-nowrap">
                                    <i class="bi bi-calendar3 me-1 text-muted"></i>
                                    @item.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")
                                </td>
                                <td>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1.5 rounded-pill fw-semibold">
                                        @item.TipoCambio
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-circle text-secondary"></i>
                                        <span class="fw-medium">Usuario #@item.UsuarioResponsableId</span>
                                    </div>
                                </td>
                                <td class="text-body-secondary">
                                    @(string.IsNullOrWhiteSpace(item.Detalle) ? "-" : item.Detalle)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>