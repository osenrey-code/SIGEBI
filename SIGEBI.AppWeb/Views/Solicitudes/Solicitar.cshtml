@model SIGEBI.AppWeb.Models.Solicitudes.RegistrarSolicitudViewModel

@{
    ViewData["Title"] = "Solicitar Préstamo";
}

<!-- HERO SECTION -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div>
        <span class="hero-badge">Módulo de Solicitudes</span>
        <h1 class="fw-bold mb-2"><i class="bi bi-journal-plus me-2"></i>Registrar Solicitud</h1>
        <p class="hero-description mb-0">Ingresa el código o identificador del ejemplar que deseas solicitar en la biblioteca.</p>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="content-card card shadow-sm rounded-4 border-0 p-4 p-lg-5">

            <form asp-action="Solicitar" method="post">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly" class="alert alert-danger border-0 shadow-sm rounded-3 mb-4" role="alert"></div>

                <div class="mb-4">
                    <label asp-for="EjemplarId" class="form-label fw-semibold text-body-secondary"></label>
                    <div class="input-group input-group-lg">
                        <span class="input-group-text border-end-0"><i class="bi bi-upc-scan"></i></span>
                        <input asp-for="EjemplarId" class="form-control border-start-0 fs-6" placeholder="Ej. 1, 2, 3..." />
                    </div>
                    <span asp-validation-for="EjemplarId" class="text-danger small mt-1 d-block"></span>
                </div>

                <div class="d-flex gap-2 pt-2">
                    <button type="submit" class="btn btn-primary btn-lg flex-fill fw-bold rounded-3 shadow-sm">
                        <i class="bi bi-send me-2"></i> Enviar Solicitud
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary btn-lg fw-semibold rounded-3 px-4">
                        Cancelar
                    </a>
                </div>
            </form>

        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}