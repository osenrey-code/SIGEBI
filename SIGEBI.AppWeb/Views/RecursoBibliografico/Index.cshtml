@model IEnumerable<SIGEBI.Application.DTOs.Response.RecursoResponse>
@{
    ViewData["Title"] = "Gestión de Recursos Bibliográficos";
}

<!-- HERO SECTION (Banner principal) -->
<div class="page-hero p-4 p-lg-5 mb-4">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
        <div>
            <span class="hero-badge">Módulo de Catálogo</span>
            <h1 class="fw-bold mb-2"><i class="bi bi-book me-2"></i>Gestión de Recursos</h1>
            <p class="hero-description mb-0">Administración del catálogo, portadas y disponibilidad física de los ejemplares.</p>
        </div>
        <div>
            <a asp-action="Crear" class="btn btn-light text-primary fw-bold px-4 py-2 rounded-3 shadow-sm d-inline-flex align-items-center gap-2">
                <i class="bi bi-plus-lg"></i> Nuevo Registro
            </a>
        </div>
    </div>
</div>

<!-- ALERTAS DE NOTIFICACIÓN -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-3 mb-4" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- BARRA DE BÚSQUEDA -->
<div class="content-card card shadow-sm rounded-4 mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group input-group-lg">
                    <span class="input-group-text border-end-0"><i class="bi bi-search"></i></span>
                    <input type="text" name="filtroBusqueda" class="form-control border-start-0 fs-6" placeholder="Buscar por título, autor o ISBN..." />
                </div>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary btn-lg fs-6 w-100 fw-semibold">Buscar</button>
                <a asp-action="Index" class="btn btn-outline-secondary btn-lg fs-6 w-100 fw-semibold">Limpiar</a>
            </div>
        </form>
    </div>
</div>

<!-- TABLA DE DATOS RESPONSIVE -->
<div class="content-card card shadow-sm rounded-4 overflow-hidden mb-4">
    <div class="table-responsive">
        <table class="table table-hover users-table align-middle mb-0">
            <thead>
                <tr>
                    <th>PORTADA</th>
                    <th>TÍTULO & AUTOR</th>
                    <th>ISBN</th>
                    <th>CATEGORÍA</th>
                    <th class="text-center">ESTADO</th>
                    <th class="text-end">ACCIONES</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td data-label="PORTADA">
                                @if (!string.IsNullOrEmpty(item.ImagenUrl))
                                {
                                    <img src="@item.ImagenUrl" alt="Portada" class="img-thumbnail rounded" style="width: 45px; height: 65px; object-fit: cover;" />
                                }
                                else
                                {
                                    <div class="bg-secondary bg-opacity-10 rounded d-flex align-items-center justify-content-center" style="width: 45px; height: 65px;">
                                        <i class="bi bi-image text-secondary"></i>
                                    </div>
                                }
                            </td>
                            <td data-label="TÍTULO & AUTOR" class="fw-bold text-body-emphasis">
                                @item.Titulo
                                <br />
                                <span class="text-body-secondary fw-normal" style="font-size: 0.85em;">@item.Autor</span>
                            </td>
                            <td data-label="ISBN" class="text-body-secondary">@item.ISBN</td>
                            <td data-label="CATEGORÍA" class="text-body-secondary">@item.Categoria</td>
                            <td data-label="ESTADO" class="text-center">
                                <span class="status-badge @(item.CopiasDisponibles > 0 ? "status-active" : "status-inactive")">
                                    <i class="bi @(item.CopiasDisponibles > 0 ? "bi-check-circle-fill" : "bi-x-circle-fill")"></i>
                                    Disp: @item.CopiasDisponibles / @item.TotalEjemplares
                                </span>
                            </td>
                            <td data-label="ACCIONES" class="actions-cell">
                                <div class="btn-group shadow-sm rounded-3">
                                    <a asp-action="Editar" asp-route-id="@item.RecursoBibliograficoId" class="btn btn-sm btn-outline-secondary" title="Editar"><i class="bi bi-pencil"></i></a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-body-secondary">No se encontraron recursos bibliográficos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>